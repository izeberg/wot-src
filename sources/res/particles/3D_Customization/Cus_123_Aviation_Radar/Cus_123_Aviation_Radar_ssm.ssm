<?xml version="1.0" encoding="utf-8"?>
<root>
	<params>
		<param>
			<name>kill</name>
			<type>trigger</type>
		</param>
		<param>
			<name>battle_start</name>
			<type>trigger</type>
		</param>
	</params>
	<node>
		<name>Sleep Node</name>
		<type>sleep</type>
		<time>1.000000 1.000000</time>
		<transition>
			<to>Battle_start</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>trigger</type>
					<name>battle_start</name>
				</condition>
			</conditions>
		</transition>
		<transition>
			<to>kill</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>trigger</type>
					<name>kill</name>
				</condition>
			</conditions>
		</transition>
		<uiPosition>0.000000 0.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>Battle_start</name>
		<type>sequence</type>
		<resource>particles/3D_Customization/Cus_123_Aviation_Radar/cus_123_battleStart.seq</resource>
		<isLoop>false</isLoop>
		<loop>1</loop>
		<transition>
			<to>Sleep Node</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>exit_time</type>
					<exitOffset>1.000000</exitOffset>
				</condition>
			</conditions>
		</transition>
		<uiPosition>-80.500000 -79.500000 0.000000</uiPosition>
	</node>
	<node>
		<name>kill</name>
		<type>sequence</type>
		<resource>particles/3D_Customization/Cus_123_Aviation_Radar/cus_123_lightUp.seq</resource>
		<isLoop>false</isLoop>
		<loop>1</loop>
		<transition>
			<to>Sleep Node</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>exit_time</type>
					<exitOffset>1.000000</exitOffset>
				</condition>
			</conditions>
		</transition>
		<uiPosition>136.500000 -76.000000 0.000000</uiPosition>
	</node>
</root>
