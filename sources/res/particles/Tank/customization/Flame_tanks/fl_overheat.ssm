<?xml version="1.0" encoding="utf-8"?>
<root>
	<params>
		<param>
			<name>isOverheated</name>
			<type>bool</type>
		</param>
		<param>
			<name>isUnderWater</name>
			<type>bool</type>
		</param>
	</params>
	<node>
		<name>Idle</name>
		<type>sleep</type>
		<time>1.000000 1.000000</time>
		<transition>
			<to>Overheat</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>bool</type>
					<name>isOverheated</name>
					<checked>true</checked>
				</condition>
			</conditions>
		</transition>
		<uiPosition>-390.500000 115.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>Overheat</name>
		<type>sequence</type>
		<resource>particles/Tank/customization/Flame_tanks/fl_overheat.seq</resource>
		<isLoop>false</isLoop>
		<loop>1</loop>
		<transition>
			<to>Overheat_long</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>exit_time</type>
					<exitOffset>1.000000</exitOffset>
				</condition>
			</conditions>
		</transition>
		<uiPosition>-394.500000 -16.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>Overheat_long</name>
		<type>sequence</type>
		<resource>particles/Tank/customization/Flame_tanks/fl_overheat_long_smoke.seq</resource>
		<isLoop>true</isLoop>
		<loop>-1</loop>
		<transition>
			<to>Idle</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>bool</type>
					<name>isOverheated</name>
					<checked>false</checked>
				</condition>
			</conditions>
		</transition>
		<transition>
			<to>Water</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>bool</type>
					<name>isUnderWater</name>
					<checked>true</checked>
				</condition>
				<condition>
					<type>bool</type>
					<name>isOverheated</name>
					<checked>true</checked>
				</condition>
			</conditions>
		</transition>
		<uiPosition>80.500000 -17.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>Water</name>
		<type>sleep</type>
		<time>1.000000 1.000000</time>
		<transition>
			<to>Idle</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>bool</type>
					<name>isOverheated</name>
					<checked>false</checked>
				</condition>
			</conditions>
		</transition>
		<transition>
			<to>Overheat_long</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>bool</type>
					<name>isUnderWater</name>
					<checked>false</checked>
				</condition>
			</conditions>
		</transition>
		<uiPosition>83.000000 109.500000 0.000000</uiPosition>
	</node>
</root>
