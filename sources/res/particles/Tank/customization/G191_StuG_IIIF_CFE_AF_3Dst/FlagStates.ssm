			<conditions>
				<condition>
					<type>float</type>
					<name>Tank_Speed</name>
					<rangeStart>7.000000</rangeStart>
					<rangeEnd>inf</rangeEnd>
				</condition>
			</conditions>
		</transition>
		<uiPosition>3.000000 -112.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>Speed_hi</name>
		<type>animation</type>
		<resource>particles/Tank/customization/G191_StuG_IIIF_CFE_AF_3Dst/Animation/flag_hi.fbx</resource>
		<clipName/>
		<isLoop>true</isLoop>
