		<resource>particles/Tank/customization/G191_StuG_IIIF_CFE_AF_3Dst/Animation/flag_idle.fbx</resource>
		<clipName/>
		<isLoop>true</isLoop>
		<transition>
			<to>Speed_low</to>
			<blendDuration>0.500000</blendDuration>
