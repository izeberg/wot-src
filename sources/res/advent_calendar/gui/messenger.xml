<?xml version="1.0" encoding="utf-8"?>
<root>
	<htmlTemplatesSimple>
		<adventLootbox>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#advent_calendar.advent_calendar:notification/lootbox/title): %(count)s&lt;/font&gt;</adventLootbox>
	</htmlTemplatesSimple>
	<htmlTemplates>
		<adventCalendarQuestReward>
			<priority>low</priority>
			<type>red</type>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;_(#advent_calendar.advent_calendar:notification/reward/received)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(rewards)s&lt;/font&gt;</message>
		</adventCalendarQuestReward>
		<adventCalendarProgressionQuestReward>
			<priority>low</priority>
			<type>red</type>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#advent_calendar.advent_calendar:notification/progerssion/recieved)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;_(#advent_calendar.advent_calendar:notification/reward/received)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(rewards)s&lt;/font&gt;</message>
		</adventCalendarProgressionQuestReward>
		<adventCalendarProgressionFinishedReward>
			<priority>low</priority>
			<type>red</type>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#advent_calendar.advent_calendar:notification/progerssion/finished)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;_(#advent_calendar.advent_calendar:notification/reward/received)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(rewards)s&lt;/font&gt;</message>
		</adventCalendarProgressionFinishedReward>
		<AdventCalendarReminder>
			<groupID>offer</groupID>
			<bgIconSizeAuto>true</bgIconSizeAuto>
			<linkage>AdventCalendarReward</linkage>
			<message>&lt;textformat leading=&quot;-1&quot;&gt;&lt;p align=&quot;center&quot;&gt;&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#messenger:serviceChannelMessages/adventCalendar/reward/header)&lt;/font&gt;&lt;/textformat&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#messenger:serviceChannelMessages/adventCalendar/reward/button)</label>
					<action>showAdventCalendar</action>
				</button>
			</buttonsLayout>
			<buttonsAlign>center</buttonsAlign>
		</AdventCalendarReminder>
	</htmlTemplates>
</root>
