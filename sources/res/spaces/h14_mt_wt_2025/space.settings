				<atlas>
					<width>2048</width>
					<height>2048</height>
					<format>DXT1</format>
					<constrains>
						<minWidth>128</minWidth>
						<minHeight>128</minHeight>
						<maxWidth>512</maxWidth>
						<maxHeight>512</maxHeight>
						<format>DXT1</format>
					</constrains>
				</atlas>
			</type>
		</scene>
		<road>
			<anisotropy>4</anisotropy>
			<quality>
				<option>
					MAX
					<mip>0</mip>
					<matTypeDownsample>0 0</matTypeDownsample>
					<materialLod>400</materialLod>
				</option>
				<option>
					HIGH
					<mip>1</mip>
					<matTypeDownsample>1 0</matTypeDownsample>
					<materialLod>300</materialLod>
				</option>
				<option>
					MEDIUM
					<mip>1</mip>
					<matTypeDownsample>1 1</matTypeDownsample>
					<materialLod>150</materialLod>
				</option>
				<option>
					LOW
					<mip>2</mip>
					<matTypeDownsample>2 1</matTypeDownsample>
					<materialLod>70</materialLod>
				</option>
				<option>
					OFF
					<mip>-1</mip>
				</option>
			</quality>
			<type>
				<name>GBufferDecals</name>
				<atlas>
					<width>2560</width>
					<height>1024</height>
					<format>DXT5</format>
					<constrains>
						<minWidth>64</minWidth>
						<minHeight>64</minHeight>
						<maxWidth>1024</maxWidth>
						<maxHeight>1024</maxHeight>
