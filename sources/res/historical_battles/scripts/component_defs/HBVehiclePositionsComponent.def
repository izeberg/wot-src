<?xml version="1.0" encoding="utf-8"?>
<root>
	<ClientMethods>
		<receivePosition>
			<Args>
				<vehicleEntityID>UINT32</vehicleEntityID>
				<position>VECTOR3</position>
			</Args>
		</receivePosition>
		<receivePositions>
			<Args>
				<positions>
					ARRAY
					<of>
						FIXED_DICT
						<Properties>
							<vehicleID>
								<Type>OBJECT_ID</Type>
							</vehicleID>
							<position>
								<Type>VECTOR3</Type>
							</position>
						</Properties>
					</of>
				</positions>
			</Args>
		</receivePositions>
	</ClientMethods>
	<ofEntity>
		<ArenaInfo/>
	</ofEntity>
	<DefaultKeyName>hbVehiclePositionsComponent</DefaultKeyName>
</root>
