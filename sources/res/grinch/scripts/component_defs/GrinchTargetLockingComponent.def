			<Type>OBJECT_ID</Type>
			<Flags>ALL_CLIENTS</Flags>
		</targetVehicleID>
		<timeToLock>
			<Type>FLOAT32</Type>
			<Flags>ALL_CLIENTS</Flags>
		</timeToLock>
		<screenFactorX>
			<Type>FLOAT32</Type>
			<Flags>ALL_CLIENTS</Flags>
		</screenFactorX>
		<screenFactorY>
			<Type>FLOAT32</Type>
			<Flags>ALL_CLIENTS</Flags>
		</screenFactorY>
		<lockOnDelay>
			<Type>FLOAT32</Type>
			<Flags>ALL_CLIENTS</Flags>
		</lockOnDelay>
		<turretVisionCone>
			<Type>FLOAT32</Type>
			<Flags>ALL_CLIENTS</Flags>
		</turretVisionCone>
		<blockers>
			<Type>
				ARRAY
				<of>STRING</of>
			</Type>
			<Flags>ALL_CLIENTS</Flags>
		</blockers>
	</Properties>
	<ofEntity>
