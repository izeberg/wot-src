<?xml version="1.0" encoding="utf-8"?>
<root>
	<DetailLevel>MY_VEHICLE</DetailLevel>
	<CellMethods>
		<updateTargetVehicleID>
			<Args>
				<vehicleID>OBJECT_ID</vehicleID>
			</Args>
			<Exposed>OWN_CLIENT</Exposed>
		</updateTargetVehicleID>
	</CellMethods>
	<Properties>
