<?xml version="1.0" encoding="utf-8"?>
<root>
	<params>
		<param>
			<name>trigger</name>
			<type>trigger</type>
		</param>
		<param>
			<name>trigger2</name>
			<type>trigger</type>
		</param>
	</params>
	<node>
		<name>lights</name>
		<type>sequence</type>
		<resource>particles/eff_sequence/h15_mt_bd_25_lights.seq</resource>
		<isLoop>true</isLoop>
		<loop>-1</loop>
		<transition>
			<to>lights_active</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>trigger</type>
					<name>trigger</name>
				</condition>
			</conditions>
		</transition>
		<uiPosition>-85.000000 -85.000000 0.000000</uiPosition>
	</node>
	<node>
		<name>lights_active</name>
		<type>sequence</type>
		<resource>particles/eff_sequence/h15_mt_bd_25_lights_active.seq</resource>
		<isLoop>false</isLoop>
		<loop>1</loop>
		<transition>
			<to>lights</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>trigger</type>
					<name>trigger2</name>
				</condition>
			</conditions>
		</transition>
		<transition>
			<to>Sleep Node</to>
			<blendDuration>0.000000</blendDuration>
			<conditions>
				<condition>
					<type>exit_time</type>
					<exitOffset>1.000000</exitOffset>
				</condition>
			</conditions>
		</transition>
		<uiPosition>-86.500000 49.500000 0.000000</uiPosition>
	</node>
	<node>
		<name>Sleep Node</name>
		<type>sleep</type>
		<time>1.000000 1.000000</time>
		<transition>
			<to>lights</to>
			<blendDuration>0.000000</blendDuration>
			<conditions/>
		</transition>
		<uiPosition>176.500000 -34.000000 0.000000</uiPosition>
	</node>
</root>
