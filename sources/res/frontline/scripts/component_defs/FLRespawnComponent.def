<?xml version="1.0" encoding="utf-8"?>
<root>
	<CellMethods>
		<onUpdateVehicleInfo>
			<Arg>OBJECT_ID</Arg>
			<Arg>PYTHON</Arg>
		</onUpdateVehicleInfo>
	</CellMethods>
	<BaseMethods>
		<arenaFinish>
			<Arg>UINT8</Arg>
		</arenaFinish>
		<updateVehicleOnRespawn>
			<Arg>OBJECT_ID</Arg>
			<Arg>UINT32</Arg>
			<ReturnValues>
				<Arg>BOOL</Arg>
			</ReturnValues>
		</updateVehicleOnRespawn>
	</BaseMethods>
	<ofEntity>
		<Arena/>
	</ofEntity>
	<DefaultKeyName>FLRespawnComponent</DefaultKeyName>
</root>
