msgstr "Калядны стол, які ломіцца ад прысмакаў"

msgid "decorations/toy_135/description"
msgstr "«Хвілінку! За чый кошт гэты банкет? Хто аплачваць будзе?»"

msgid "decorations/toy_135/name"
msgstr "Абрус-самабор"

msgid "decorations/toy_136/description"
msgstr ""
"«І пасля гэтакай вячэры\n"
"Жывот выпучваўся без меры,\n"
"А з-за стала як уставалі,\n"
"То нават трохі і стагналі»."

msgid "decorations/toy_136/name"
msgstr "Шчодрая калядная вячэра"

msgid "decorations/toy_137/description"
msgstr ""
"Прыехаў да бабулі, ад вячэры адмовіўся, папрасіў хіба толькі гарбаты...\n"
"\n"
"Далей ідзе мантажная склейка з застаўкай «A Few Moments Later»."

msgid "decorations/toy_137/name"
msgstr "Сціплае чаяванне"

msgid "decorations/toy_138/description"
msgstr ""
"«Гэта ж нейкі гастрафэст\n"
"Спажывання ваш працэс!\n"
"Як у вас там п'юць какаву?\n"
"З сахарынам? Альбо без?»"

msgid "decorations/toy_138/name"
msgstr "Салодкі стол"

