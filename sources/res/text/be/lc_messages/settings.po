msgstr "Прымаць запрашэнні ў Гаражы толькі ад сяброў"

msgid "chat/receiveClanInvitesNotifications"
msgstr "Атрымліваць кланавыя апавяшчэнні"

msgid "chat/receiveFriendshipRequest"
msgstr "Прымаць запыты на дадаванне ў сябры"

msgid "chat/receiveInvitesInBattle"
msgstr "Прымаць запрашэнні ў звяз у баі"

msgid "chat/removeSpam"
msgstr "Не паказваць спам"

msgid "chat/showDateMessage"
msgstr "Паказваць дату паведамлення"

msgid "chat/showJoinLeaveMessages"
