msgstr "Прымаць паведамленні толькі са спіса кантактаў"

msgid "chat/disableBattleChat"
msgstr "Отключить чат"

msgid "chat/enableStoreChannelsWindows"
msgstr "Памятаць пазіцыю камеры і вокнаў каналаў"

msgid "chat/enableStoreManagementWindows"
msgstr "Памятаць пазіцыю камеры і іншых вокнаў"

