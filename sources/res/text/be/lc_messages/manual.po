msgstr "Тыпы тэхнікі"

msgid "manual_has/content"
msgstr "!"

msgid "manual_update/hint"
msgstr ""
"АСНОЎНАЯ ІНФАРМАЦЫЯ\n"
"І ІНСТРУКТАЖ"
