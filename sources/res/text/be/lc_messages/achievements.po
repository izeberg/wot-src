"адмысловай падзеі."

msgid "se12019Medal_descr"
msgstr "Перамагчы ў 10 баях падзеі «Апошні рубеж»."

msgid "se2020Medal"
msgstr "Вялікая Перамога"

msgid "se2020Medal_condition"
msgstr ""
