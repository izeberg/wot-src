msgstr "Выявіць"

msgid "regular_1_1_10_description_topByExp"
msgstr "Трапіць у топ-3 паводле досведу ў сваёй камандзе."

msgid "regular_1_1_10_title_topByExp"
msgstr "Вынік"

msgid "regular_1_1_11_description_damage"
msgstr "Стрэламі прычыніць %(goal)s пашкоджанняў тэхніцы праціўніка."

msgid "regular_1_1_11_description_hits"
msgstr ""
"Стрэламі %(goal)s разы прычыніць пашкоджанні тэхніцы свайго або вышэйшага "
"ўзроўню."

msgid "regular_1_1_11_title_damage"
msgstr "Пашкоджанні"

msgid "regular_1_1_11_title_hits"
msgstr "Пашкоджанні"

msgid "regular_1_1_12_description_assist"
msgstr ""
"Перадаць разведданыя на %(goal)s пашкоджанняў, застаючыся нябачным падчас іх"
" прычынення."

msgid "regular_1_1_12_description_installedCamouflage"
msgstr "Уступіць у бой з камуфляжам, нанесеным як мінімум на корпус машыны."

msgid "regular_1_1_12_description_installedModules"
msgstr "Уступіць у бой на машыне з маскіровачнай сеткай."

msgid "regular_1_1_12_title_assist"
msgstr "Разведданыя"

msgid "regular_1_1_12_title_installedCamouflage"
msgstr "Падрыхтоўка да бою"

msgid "regular_1_1_12_title_installedModules"
