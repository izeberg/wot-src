msgid "infoBattleContextHint/AmmunitionCrit"
msgstr ""
"%(F37A02_Open)sКрытычныя пашкоджанні боеўкладкі%(F37A02_Close)s вядуць \n"
"да імгненнага %(F37A02_Open)sзнішчэння машыны.%(F37A02_Close)s"

msgid "infoBattleContextHint/FueltankCrit"
msgstr ""
"Не забуддзьцеся%(F37A02_Open)s вогнетушыцель,%(F37A02_Close)s каб\n"
"%(F37A02_Open)sпрадухіліць пажар.%(F37A02_Close)s"

msgid "infoBattleContextHint/InSafetyWhileNotObserved"
msgstr ""
"%(F37A02_Open)s«Лямпачка» не паказваецца,%(F37A02_Close)s пакуль\n"
"%(F37A02_Open)sвы нябачны%(F37A02_Close)s для праціўніка."

msgid "infoBattleContextHint/KilledWhileObserved"
msgstr ""
"Індыкатар %(F37A02_Open)s«лямпачка» — вы ў небяспецы,%(F37A02_Close)s\n"
"праціўнік можа вас бачыць."

msgid "infoBattleContextHint/ModuleDamage"
msgstr ""
"Кожны%(F37A02_Open)s пашкоджаны модуль%(F37A02_Close)s уплывае\n"
"на %(F37A02_Open)sхарактарыстыкі машыны.%(F37A02_Close)s"

