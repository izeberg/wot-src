msgid "tooltips/resourcesLoadingView/header/currency_description"
msgstr ""
"Шэраг гульнявых валют, якія можна выкарыстаць для абмену. Золата можна "
"набыць за рэальныя грошы, астатняе — заслужыць у баях, атрымаць за баявыя "
"задачы і іншыя актыўныя дзеянні ў гульні."

msgid "tooltips/resourcesLoadingView/header/currency_title"
msgstr "Рэсурсы"

msgid "tooltips/resourcesLoadingView/header/premiums_description"
msgstr "Дні Танкавага прэміум акаўнту."

msgid "tooltips/resourcesLoadingView/header/premiums_title"
