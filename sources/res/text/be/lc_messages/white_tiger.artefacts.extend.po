msgid "wt_teleport_mod_a/name"
msgstr "Тэлепорт"

msgid "wt_teleport_mod_a/onUse"
msgstr ""
"Позволяет телепортироваться в выбранную точку на карте. Активация занимает "
"некоторое время."

msgid "wt_teleport_mod_a/restriction"
msgstr "Способность недоступна без активного щита."

msgid "wt_teleport_mod_a/short_special"
