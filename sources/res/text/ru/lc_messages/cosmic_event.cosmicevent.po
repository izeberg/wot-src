msgid "artefact/actionList/desc/abilityHit"
msgstr ""
"Очки начисляются при успешном использовании усилений. Число очков будет "
"умножено на число машин, затронутых усилением."

msgid "artefact/actionList/desc/assist"
msgstr "Очки начисляются за непосредственный вклад в устранение машины."

msgid "artefact/actionList/desc/firstBlood"
msgstr "Очки начисляются тому, кто первым в заезде устранит машину."

msgid "artefact/actionList/desc/kill"
