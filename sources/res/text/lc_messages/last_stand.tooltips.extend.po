msgid "Contact/status/inBattle/last_stand"
msgstr "In a Last Stand battle"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr ""
"Fires a shot that damages the target and all enemy vehicles within a 35 m "
"radius."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr ""
"Fires a shot that restores hit points by stealing them from the target and "
"nearby enemy vehicles within a 35 m radius."

msgid "advanced/ls_aoeStunInstantShot"
msgstr ""
"Fires a shot that stuns the target and all enemy vehicles within a 35 m "
"radius."

msgid "advanced/ls_damageShield"
msgstr ""
"Protects against any damage (except ramming, drowning, and impact) for 7 "
"seconds."

msgid "advanced/ls_doubleDamage"
msgstr "Your next successful shot causes double damage."

msgid "advanced/ls_equipment"
msgstr ""
"Tactical Devices help you fight more effectively in Last Stand battles, "
"complete Stages, and earn valuable rewards. To equip them, click one of the "
"Tactical Device slots."

msgid "advanced/ls_extraDamageSituational"
msgstr "Gives a chance to deal increased damage to an enemy vehicle."

msgid "advanced/ls_fastReload"
msgstr "Increases rate of fire / reloads magazine."

msgid "advanced/ls_healSituational"
msgstr "Restores some hit points after destroying an enemy vehicle."

msgid "advanced/ls_invisibility"
msgstr ""
"Temporarily stops enemies from targeting your vehicle, restores hit points, "
"repairs modules, extinguishes fire, removes the stun effect, and treats all "
"injured crew members."

msgid "advanced/ls_nitro"
msgstr "Temporarily increases your vehicle's mobility."

msgid "advanced/ls_nitroSituational"
msgstr ""
"Temporarily increases your vehicle's mobility after taking damage from an "
"enemy vehicle."

msgid "advanced/ls_selfRepairKit"
msgstr ""
"Restores hit points, extinguishes fire, removes the stun effect, and repairs"
" damaged modules."

msgid "advanced/ls_teamRepairKit"
msgstr ""
"Repairs damaged modules, extinguishes fire, removes the stun effect, and "
"restores some hit points to allied vehicles within its radius."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr ""
"Tactical Devices can be equipped in special slots to help you fight more "
"effectively in Last Stand battles, complete Stages, and earn valuable "
"rewards."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Tactical Device Slots"
