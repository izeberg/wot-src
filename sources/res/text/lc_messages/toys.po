msgstr "\"I see a green tree and I want it painted black...\""

msgid "decorations/toy_96/name"
msgstr "Black"

msgid "decorations/toy_97/description"
msgstr "You wouldn't like this tree when it's angry."

msgid "decorations/toy_97/name"
msgstr "Bright Gradient"

msgid "decorations/toy_98/description"
msgstr "This is a tree of ice and fire."

msgid "decorations/toy_98/name"
msgstr "Muted Gradient"

msgid "decorations/toy_99/description"
msgstr "Provides a bonus of +50% to your Tree's concealment."

msgid "decorations/toy_99/name"
msgstr "Transparent"
