msgid "decorations/toy_9/description"
msgstr ""
"\"It's a great huge game of chess that's being played—all over the world! If"
" this is the world at all, you know.\""

msgid "decorations/toy_9/name"
msgstr "Queen Crown"

msgid "decorations/toy_90/description"
msgstr "What do you call an old snowman? A puddle."

