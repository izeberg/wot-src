msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s Tier&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr ""
"Take control of the antennas. Hold the network. Secure the transmission."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr ""
"Your computer's performance is insufficient for this mode. You may "
"experience issues with graphics and vehicle movement. Game client crashes "
"are also likely."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Low Performance"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Low Performance"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr ""
"This mode requires high computer performance. You will experience issues "
"with map loading, graphics, and vehicle movement. In case of insufficient "
"performance, try a lower graphics quality in your Settings."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Reduced Performance"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Reduced Performance"
