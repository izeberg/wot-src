msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "%(count) remaining Object"
msgstr[1] "%(count) remaining Objects"
msgstr[2] "%(count) remaining Objects"

msgid "awardViews/footer/backButton/"
msgstr "Back to Objects"

msgid "boxTooltip/description/text/ls_invasion_common"
msgstr ""
"When opened, Shards may grant you vehicles, in-game currencies, and other "
"valuable rewards."

msgid "boxTooltip/description/text/ls_invasion_epic"
msgstr ""
"When opened, Cores may grant you vehicles, customization elements, in-game "
"currencies, and other valuable rewards."

msgid "boxTooltip/description/text/ls_invasion_rare"
msgstr ""
"When opened, Fragments may grant you vehicles, customization elements, in-"
"game currencies, and other valuable rewards."

msgid "boxTooltip/howGet/text/ls_invasion_common"
msgstr ""
"Shards can be obtained in the in-game Store and received when opening "
"Fragments or Cores, as well as other Shards."

msgid "boxTooltip/howGet/text/ls_invasion_epic"
msgstr ""
"Can be received while opening Shards or Fragments, as well as other Cores."

msgid "boxTooltip/howGet/text/ls_invasion_rare"
msgstr ""
"Can be received while opening Shards or Cores, as well as other Fragments."

msgid "common/boxCategory/lowerCase/ls_invasion_common"
msgstr "Shard"

msgid "common/boxCategory/lowerCase/ls_invasion_epic"
msgstr "Core"

msgid "common/boxCategory/lowerCase/ls_invasion_rare"
msgstr "Fragment"

msgid "common/boxCategory/upperCase/ls_invasion_common"
msgstr "SHARD"

msgid "common/boxCategory/upperCase/ls_invasion_epic"
msgstr "CORE"

msgid "common/boxCategory/upperCase/ls_invasion_rare"
msgstr "FRAGMENT"

msgid "common/getButton/lowerCase"
msgstr "Get Shards"

msgid "common/getButton/upperCase"
msgstr "GET SHARDS"

msgid "common/loader"
msgstr "Object opening..."

msgid "common/statistics/emptyHeader"
msgstr "Open Objects to view statistics."

msgid "common/statistics/header"
msgstr "Objects opened: %(count)"

msgid "common/statistics/tooltip/body"
msgstr ""
"Here you can view the items you received from Objects during the event. You "
"can manually reset these statistics at any time."

msgid "confirmResetLootBoxStatistics/description"
msgstr "All information on opened Objects will be deleted."

msgid "entryPoint/boxes"
msgstr "TO SHARDS"

msgid "entryPoint/tooltip/description"
msgstr ""
"Shards contain new and unique items including vehicles, in-game currencies, and other valuable rewards.\n"
"They can be obtained in the in-game Store and received when opening Fragments or Cores, as well as other Shards."

msgid "entryPoint/tooltip/title"
msgstr "Shards and How to Receive Them"

msgid "entryPoint/tooltip/warningDescription"
msgstr ""
"Shards cannot currently be opened or purchased due to technical reasons. We "
"apologize for the temporary inconvenience."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Shards Temporarily Unavailable"

msgid "eventName/lowerCase"
msgstr "Subspace Secrets"

msgid "eventName/upperCase"
msgstr "SUBSPACE SECRETS"

msgid "guaranteedTitle/nextBox"
msgstr "Guaranteed Reward in the next Object!"

msgid "guaranteedTitle/text"
msgstr "Maximum Objects before a Guaranteed Reward: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr ""
"If you do not open all Objects before the end of the event, they will be "
"opened automatically later."

msgid "infoPage/footer/description/compensation"
msgstr ""
"If you already own all the vehicles from the Objects, you will receive a "
"Core as a reward instead of a vehicle."

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"Every %(guaranteed0)s Shards, %(guaranteed1)s Fragments, and %(guaranteed2)s"
" Cores are guaranteed to contain a vehicle. If you open them without one "
"dropping such a vehicle, then a vehicle you do not already own will drop "
"when you open the "
"%(guaranteed0)s&zwnbsp;th/%(guaranteed1)s&zwnbsp;th/%(guaranteed2)s&zwnbsp;th"
" Object (depending on the object type). When it does, the counter is reset."

msgid "infoPage/footer/title/compensation"
msgstr "If All Vehicles Are Received"

msgid "infoPage/header/description"
msgstr ""
"Open the Object for the chance to receive valuable in-game items!\n"
"See below for a list of possible rewards."

msgid "multipleRewardView/header/subTitle/"
msgstr "From the %(name) (%(boxesCount) Objects opened)"

msgid "noBoxesView/description/"
msgstr ""
"You do not have any Shards.\n"
"You can get them in the in-game Store."

msgid "preview/backLabel"
msgstr "TO OBJECTS"

msgid "quantityTitle/boxesAvailable"
msgstr "Objects available: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No Objects available"

msgid "serviceChannelMessages/finish/text"
msgstr ""
"All remaining Objects will be opened. Their contents will be added to your "
"account."

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "Objects opened: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "Remaining Opened"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr ""
"At the end of the event, we opened all of your Objects and added their "
"contents to your account."

msgid "serviceChannelMessages/lootBoxesDisabled/header"
msgstr "Object Opening Suspended"

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr ""
"Operations with Objects are temporarily unavailable due to maintenance."

msgid "serviceChannelMessages/lootBoxesEnabled/header"
msgstr "Object Opening Available"

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "Operations with Objects are available again. Open them!"

msgid "serviceChannelMessages/multipleOpen"
msgstr "Objects opened!"

msgid "serviceChannelMessages/server_error"
msgstr "Object Not Opened"

msgid "singleRewardView/tooltip/description/"
msgstr ""
"If you already own all the vehicles from the Objects, you will receive a "
"Core as a Guaranteed Reward instead of a vehicle."

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"The Guaranteed Reward is a vehicle from the list of possible Object contents.\n"
"If you open %(remainingCount) Objects without one dropping such a vehicle, it will drop when you open the %(count) Object. When it does, the counter is reset."
