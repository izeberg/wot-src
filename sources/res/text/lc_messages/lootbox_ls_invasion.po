msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "剩余%(count)个相位体补给品"
msgstr[1] "剩余%(count)个相位体补给品"
msgstr[2] "剩余%(count)个相位体补给品"

msgid "awardViews/footer/backButton/"
msgstr "返回相位体补给品"

msgid "boxTooltip/description/text/ls_invasion_common"
msgstr "开启后，您将有机会从初级相位体补给品中获得坦克、游戏内货币，以及其他珍贵奖励。"

msgid "boxTooltip/description/text/ls_invasion_epic"
msgstr "开启后，您将有机会从究极相位体补给品中获得坦克、个性化元素、游戏内货币，以及其他珍贵奖励。"

msgid "boxTooltip/description/text/ls_invasion_rare"
msgstr "开启后，您将有机会从高级相位体补给品中获得坦克、个性化元素、游戏内货币，以及其他珍贵奖励。"

msgid "boxTooltip/howGet/text/ls_invasion_common"
msgstr "初级相位体补给品可通过在军械库中购买相应礼包来获取，开启高级、究极相位体补给品，以及其他初级相位体补给品时也有机会获得。"

msgid "boxTooltip/howGet/text/ls_invasion_epic"
msgstr "可在开启初级或高级相位体补给品，以及其他究极相位体补给品时获取。"

msgid "boxTooltip/howGet/text/ls_invasion_rare"
msgstr "可在开启初级或究极相位体补给品，以及其他高级相位体补给品时获取。"

msgid "common/boxCategory/lowerCase/ls_invasion_common"
msgstr "初级相位体补给品"

msgid "common/boxCategory/lowerCase/ls_invasion_epic"
msgstr "究极相位体补给品"

msgid "common/boxCategory/lowerCase/ls_invasion_rare"
msgstr "高级相位体补给品"

msgid "common/boxCategory/upperCase/ls_invasion_common"
msgstr "初级相位体补给品"

msgid "common/boxCategory/upperCase/ls_invasion_epic"
msgstr "究极相位体补给品"

msgid "common/boxCategory/upperCase/ls_invasion_rare"
msgstr "高级相位体补给品"

msgid "common/getButton/lowerCase"
msgstr "获取补给品礼包"

msgid "common/getButton/upperCase"
msgstr "获取补给品礼包"

msgid "common/loader"
msgstr "正在开启相位体补给品..."

msgid "common/statistics/emptyHeader"
msgstr "开启相位体补给品即可查看统计数据。"

msgid "common/statistics/header"
msgstr "已开启相位体补给品: %(count)"

msgid "common/statistics/tooltip/body"
msgstr "此处显示您在活动期间从相位体补给品中所获得的物品。您可随时手动重置统计数据。"

msgid "confirmResetLootBoxStatistics/description"
msgstr "已开启相位体补给品的所有信息都将被删除。"

msgid "entryPoint/boxes"
msgstr "前往相位体补给品"

msgid "entryPoint/tooltip/description"
msgstr ""
"初级相位体补给品内含全新且独特的物品，包括坦克、游戏内货币，以及其他珍贵奖励。\n"
"初级相位体补给品可通过在军械库中购买相应礼包来获取，开启高级、究极相位体补给品，以及其他初级相位体补给品时也有机会获得。"

msgid "entryPoint/tooltip/title"
msgstr "初级相位体补给品礼包及其获取方式"

msgid "entryPoint/tooltip/warningDescription"
msgstr "由于技术原因，目前无法开启或购买初级相位体补给品。我们对造成的不便深表歉意。"

msgid "entryPoint/tooltip/warningTitle"
msgstr "初级相位体补给品暂不可用"

msgid "eventName/lowerCase"
msgstr "亚空间的秘密"

msgid "eventName/upperCase"
msgstr "亚空间的秘密"

msgid "guaranteedTitle/nextBox"
msgstr "下个相位体补给品必定掉落保底奖励！"

msgid "guaranteedTitle/text"
msgstr "保底奖励掉落前还需开启的最大相位体补给品数: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "如果您在活动结束前没有开启全部相位体补给品，那么系统稍后会自动开启这些补给品。"

msgid "infoPage/footer/description/compensation"
msgstr "如果车库中已拥有相位体补给品中的全部坦克，那么您将获得究极相位体补给品作为保底奖励，而非坦克。"

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"每%(guaranteed0)s个初级相位体补给品、%(guaranteed1)s个高级相位体补给品和%(guaranteed2)s个究极相位体补给品都保底内含1辆坦克。如果这些补给品始终未掉落保底坦克，那么当您开启第%(guaranteed0)s/%(guaranteed1)s/%(guaranteed2)s个相位体补给品(取决于相位体补给品类型)时，必定会掉落1辆您车库中尚未拥有的坦克。相位体补给品掉落坦克后，计数器将重置。"

msgid "infoPage/footer/title/compensation"
msgstr "如果车库中已拥有补给品内含的全部坦克"

msgid "infoPage/header/description"
msgstr ""
"开启相位体补给品，即有机会获得珍贵的游戏内物品！\n"
"请在下方查看有机会获得的奖励列表。"

msgid "multipleRewardView/header/subTitle/"
msgstr "从%(name)中获得的奖励(已开启%(boxesCount)个相位体补给品)"

msgid "noBoxesView/description/"
msgstr ""
"您没有任何初级相位体补给品。\n"
"您可以在军械库中购买补给品礼包。"

msgid "preview/backLabel"
msgstr "前往相位体补给品"

msgid "quantityTitle/boxesAvailable"
msgstr "可用的相位体补给品: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "没有可用的相位体补给品"

msgid "serviceChannelMessages/finish/text"
msgstr "系统将开启所有剩余的相位体补给品。所含奖励将添加至您的账号。"

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "已开启相位体补给品: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "已开启剩余的补给品"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr "活动结束后，我们开启了您全部的相位体补给品，所含奖励已添加至您的账号。"

msgid "serviceChannelMessages/lootBoxesDisabled/header"
msgstr "暂时无法开启相位体补给品"

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr "由于服务器维护，相位体补给品的相关操作暂时无法进行。"

msgid "serviceChannelMessages/lootBoxesEnabled/header"
msgstr "相位体补给品开启已恢复"

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "相位体补给品相关操作已恢复正常。去开启补给品吧！"

msgid "serviceChannelMessages/multipleOpen"
msgstr "已开启相位体补给品！"

msgid "serviceChannelMessages/server_error"
msgstr "未开启相位体补给品"

msgid "singleRewardView/tooltip/description/"
msgstr "如果车库中已拥有相位体补给品中的全部坦克，那么您将获得一个究极相位体补给品作为保底奖励，而非坦克。"

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"保底奖励是相位体补给品内容列表中的一辆坦克。\n"
"如果开启%(remainingCount)个相位补给品后仍未掉落保底坦克，那么当第%(count)个相位体补给品开启时必定会掉落。补给品掉落坦克后，计数器将重置。"
