msgid "bannerTooltip/allStagesAreCompleted"
msgstr "All stages are completed!"

msgid "bannerTooltip/description"
msgstr ""
"The Blitzträger against the Harriers: asymmetrical 1v6 combat in modified "
"vehicles. Earn unique customization elements and other valuable rewards."

