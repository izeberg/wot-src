msgid "event/ChallengeEventBanner/tooltip/description"
msgstr ""
"Enter the Crucible, where champions are forged! Activate a series of "
"missions, then earn rewards as you complete them. Only one series of "
"missions can be active at a time, and missions must be completed in order. "
"Test your skills and fight your way to glory!"

msgid "event/ChallengeEventBanner/tooltip/timer/text"
msgstr "Nearest Crucible mission ends in %(timer)s"

