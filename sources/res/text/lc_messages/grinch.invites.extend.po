msgid "invites/note/change_and_leave/PREBATTLE_GRINCH"
msgstr ""
"Once you accept the invitation, you will exit Winter Raid and be transferred"
" to the %(host)s server."

msgid "invites/note/change_and_leave/QUEUE_GRINCH"
msgstr ""
"Once you accept the invitation, you will exit Winter Raid and be transferred"
" to the %(host)s server."

msgid "invites/note/leave/PREBATTLE_GRINCH"
msgstr "You will be automatically removed from the tactical unit."

msgid "invites/note/leave/QUEUE_GRINCH"
msgstr "Once you accept the invitation, you will exit Winter Raid."

msgid "invites/prebattle/alreadyJoined/GRINCH"
msgstr "You have already joined the Winter Raid Platoon."

msgid "invites/text/GRINCH"
msgstr "Invitation to Join Winter Raid Platoon"
