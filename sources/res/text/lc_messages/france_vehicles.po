msgid "AMC_35_SH"
msgstr "阿勒坎"

msgid "AMC_35_SH_descr"
msgstr ""
"轻量化、流线外型与优雅外观是F系坦克的三大特色。这辆坦克上没有任何通过工业间谍行为盗取的设计或技术，而是完完全全的原创，并融合了颇具效率的设计思路及行之有效的解决方案。"

msgid "AMC_35_SH_short"
msgstr "阿勒坎"

