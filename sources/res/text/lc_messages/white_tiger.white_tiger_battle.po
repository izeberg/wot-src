msgstr "发电机%(index)s"

msgid "postbattle_screen/botName"
msgstr "哨兵"

msgid "reticle/dmg"
msgstr "+%(num)s%%损伤"

msgid "stats/team/boss"
msgstr "工程师"

msgid "stats/team/hunters"
msgstr "猎犬小队"

