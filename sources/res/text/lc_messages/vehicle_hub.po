msgstr "ИК-система поиска и слежения (ИК-СПС)"

msgid "abilities/special/name/stagedJetBoosters"
msgstr "Последовательные ракетные ускорители"

msgid "abilities/special/name/stanceDance"
msgstr "Тактическая силовая установка"

msgid "abilities/special/name/stationaryReload"
msgstr "Модуль внешней подачи боеприпасов"

msgid "abilities/special/name/supportWeapon"
msgstr "Вспомогательные орудия"

msgid "abilities/special/name/targetDesignator"
msgstr "Лазерный целеуказатель"

msgid "abilities/special/name/twinGun"
msgstr "Залповый режим"

msgid "abilities/special/name/wheeledDash"
msgstr "Вспомогательный турбонагнетатель высокого давления"

msgid "abilities/special/shortDescription/accuracyStacks"
msgstr ""
"Увеличивает точность следующего выстрела с хорошей стабилизацией при полной "
"калибровке."

msgid "abilities/special/shortDescription/autoreloaderSurge"
msgstr "Мгновенно уменьшает время перезарядки до определённого значения."

msgid "abilities/special/shortDescription/auxiliaryRocketLauncher"
msgstr "Запускает неуправляемую ОФ ракету из спаренной установки."

msgid "abilities/special/shortDescription/battleFury"
msgstr ""
"Каждое попадание по машине противника на некоторое время ускоряет "
"перезарядку."

msgid "abilities/special/shortDescription/bustleFeed"
msgstr ""
"Стреляет снарядами с высоким уроном, жертвуя мобильностью и "
"скорострельностью."

msgid "abilities/special/shortDescription/chargeShot"
msgstr ""
"Набирайте уровни нагрева, чтобы нанести больше урона машинам противника "
"следующим выстрелом."

msgid "abilities/special/shortDescription/chargeableBurst"
msgstr "Кассета, которая позволяет вам выстрелить очередью из двух снарядов."

msgid "abilities/special/shortDescription/concentrationMode"
msgstr ""
"Максимизирует стабилизацию в движении и при поворотах для более точной "
"стрельбы."

msgid "abilities/special/shortDescription/extraShotClip"
msgstr ""
"Автоматически начинает перезарядку на последнем снаряде, которым тем не "
"менее можно выстрелить."

msgid "abilities/special/shortDescription/heatingZonesGun"
msgstr ""
"Активная система охлаждения, снижающая разброс по мере остывания орудия."

msgid "abilities/special/shortDescription/improvedRamming"
msgstr "Увеличивает урон тараном, наносимый технике противника."

msgid "abilities/special/shortDescription/lowChargeShot"
msgstr ""
"Специальная механика орудия, которая позволяет выстрелить раньше за счёт "
"снижения эффективности снаряда."

msgid "abilities/special/shortDescription/overheatGun"
msgstr ""
"Система обеспечивает непрерывную стрельбу без перезарядки и контролирует "
"количество тепла, выделяемого при ведении огня."

msgid "abilities/special/shortDescription/overheatStacks"
msgstr ""
"Оставаясь на месте или двигаясь медленно, увеличивает урон и точность "
"следующего выстрела."

msgid "abilities/special/shortDescription/pillboxSiegeMode"
msgstr ""
"Значительно увеличивает точность и скорость перезарядки, но заметно ухудшает"
" мобильность."

msgid "abilities/special/shortDescription/powerMode"
msgstr ""
"Увеличивает мощность двигателя и максимальную скорость по мере движения "
"машины."

msgid "abilities/special/shortDescription/propellantAfterburnerGun"
msgstr ""
"Система заряжается, чтобы увеличить урон. Чем больше заряд, тем выше "
"наносимый урон."

msgid "abilities/special/shortDescription/rechargeableNitro"
msgstr ""
"Ускорители, которые можно активировать в любой момент для резкого прироста "
"скорости."

msgid "abilities/special/shortDescription/shellCalibration"
msgstr ""
"Попадание в обнаруженного противника увеличивает урон или бронепробиваемость"
" следующего снаряда."

msgid "abilities/special/shortDescription/shellParamsSwitcher"
msgstr ""
"Орудие оснащено устройствами, которые позволяют изменять некоторые параметры"
" снаряда перед выстрелом."

msgid "abilities/special/shortDescription/sightPointer"
msgstr ""
"Увеличивает дальность обзора и обнаруживает движущуюся и замаскированную "
"технику в узком секторе."

msgid "abilities/special/shortDescription/stagedJetBoosters"
msgstr ""
"Твердотопливные ускорители улучшают разгон, мобильность и манёвренность."

msgid "abilities/special/shortDescription/stanceDance"
msgstr ""
"Заряжает одну из двух уникальных способностей, увеличивая скорость или "
"повышая точность орудия."

msgid "abilities/special/shortDescription/stationaryReload"
msgstr ""
"Позволяет прервать перезарядку и выстрелить в ответ в критический момент."

msgid "abilities/special/shortDescription/supportWeapon"
msgstr ""
"Дополнительное вооружение, которое увеличивает огневую мощь в дополнение к "
"основному орудию."

msgid "abilities/special/shortDescription/targetDesignator"
msgstr ""
"Увеличивает время видимости обнаруженной техники противника и урон по ней "
"либо отмечает её специальным маркером."

msgid "abilities/special/shortDescription/twinGun"
msgstr ""
"Позволяет выстрелить из двух орудий одновременно, но увеличивает время "
"перезарядки."

msgid "abilities/special/shortDescription/wheeledDash"
msgstr ""
"Специальная механика, которая улучшает параметры мощности двигателя, "
"ускорения и максимальной скорости на короткое время."

msgid "characteristics/abilities/special/description/accuracyStacks"
msgstr ""
"Оставаясь неподвижным или двигаясь медленнее определённой скорости, вы "
"можете откалибровать аналоговый баллистический вычислитель вашей машины и "
"набрать уровни точности, что сделает ваш следующий выстрел более точным. "
"Если вы превысите указанную скорость, набор уровней точности остановится, "
"пока вы не замедлитесь. На максимальном уровне точности ваша машина получает"
" хорошую стабилизацию орудия с уменьшенным разбросом при движении и "
"поворотах корпуса/башни. Эффект сбрасывается после выстрела."

msgid "characteristics/abilities/special/description/auxiliaryRocketLauncher"
msgstr ""
"Машина оснащена ракетной пусковой установкой в маске орудия. Активируйте "
"способность, чтобы переключиться на прицел вспомогательного оружия и "
"запустите неуправляемую ОФ ракету кнопкой выстрела."

msgid "characteristics/abilities/special/description/battleFury"
msgstr ""
"При каждом попадании по видимому противнику вы получаете уровень "
"эффективности перезарядки, временно ускоряющий перезарядку вашего орудия. "
"При уничтожении машины противника вы получаете дополнительные уровни "
"эффективности перезарядки."

msgid "characteristics/abilities/special/description/bustleFeed"
msgstr ""
"Модуль внешней подачи боеприпасов позволяет выстрелить единичным снарядом "
"повышенной мощности, который наносит увеличенный урон. Активация модуля "
"снижает мобильность и скорострельность."

msgid "characteristics/abilities/special/description/chargeShot"
msgstr ""
"При заряженном орудии вы можете начать нагревать ваш следующий снаряд. Чем "
"выше уровень нагрева, тем больше бонус к среднему урону. В процессе нагрева "
"вы не можете менять тип снаряда. При достижении максимального уровня нагрева"
" начинается обратный отсчёт. Если не удастся выстрелить до его окончания, вы"
" не сможете стрелять ещё несколько секунд."

msgid "characteristics/abilities/special/description/chargeableBurst"
msgstr ""
"После двух попаданий с пробитием техники противника активируется режим "
"очереди, который заряжает кассету, позволяющую вам совершить два быстрых "
"выстрела подряд."

msgid "characteristics/abilities/special/description/concentrationMode"
msgstr ""
"Пневматический гиростабилизатор на короткое время обеспечивает максимальную "
"стабилизацию во время поворота корпуса и башни, что позволяет более точно "
"стрелять на ходу и быстрее реагировать на угрозы."

msgid "characteristics/abilities/special/description/extraShotClip"
msgstr ""
"Система автоматически начинает заряжать новую кассету, когда в текущей "
"остаётся один снаряд. Если в процессе выстрелить последним снарядом, ко "
"времени перезарядки добавится несколько секунд. Нажатие кнопки перезарядки "
"кассеты убирает из неё все снаряды, кроме одного. Двойное нажатие этой "
"кнопки начинает полную перезарядку кассеты."

msgid "characteristics/abilities/special/description/heatingZonesGun"
msgstr ""
"Система поддерживает орудие в охлаждённом состоянии, чтобы обеспечить точную"
" стрельбу. После выстрела орудие нагревается, а уже во время перезарядки "
"охлаждается, становясь эффективнее. Чем выше температура, тем сильнее "
"меняются некоторые параметры орудия."

msgid "characteristics/abilities/special/description/improvedRamming"
msgstr ""
"Эта машина скомпонована специально для атак тараном. Набор конструктивных "
"модификаций позволяет ей наносить больше урона при таране."

msgid "characteristics/abilities/special/description/lowChargeShot"
msgstr ""
"Эта машина может стрелять преждевременно: выстрелы с одиночным зарядом, "
"сделанные во время перезарядки, менее эффективны, в то время как снаряды с "
"полным зарядом после перезарядки обладают оптимальными баллистическими "
"характеристиками."

msgid "characteristics/abilities/special/description/overheatGun"
msgstr ""
"Это орудие не требует перезарядки. Каждый выстрел нагревает его: чем выше "
"температура, тем сильнее меняются некоторые параметры. Непрерывная стрельба "
"приводит к перегреву, после чего вести огонь становится невозможно до "
"остывания."

msgid "characteristics/abilities/special/description/overheatStacks"
msgstr ""
"Оставаясь неподвижным или двигаясь медленнее определённой скорости, вы "
"набираете преднагрев, который увеличивает средний урон и точность вашего "
"следующего выстрела. Превышение указанной скорости постепенно снижает "
"значение бонуса, а выстрел или смена типа снаряда мгновенно сбрасывает его. "
"На максимальном уровне преднагрева попадание с пробитием техники противника,"
" у которой меньше очков прочности, чем ваш средний урон (включая бонус от "
"преднагрева), вызывает подрыв боекомплекта, что мгновенно уничтожает машину."

msgid "characteristics/abilities/special/description/pillboxSiegeMode"
msgstr ""
"В этом режиме существенно улучшаются разброс орудия, скорость перезарядки и "
"углы вертикального наведения, однако мобильность (максимальная скорость "
"переднего/заднего хода и скорость горизонтального/вертикального наведения) "
"значительно ограничена. Процентные значения указаны относительно осадного "
"режима."

msgid "characteristics/abilities/special/description/powerMode"
msgstr ""
"Прямая передача даёт значительный бонус к мощности двигателя и максимальной "
"скорости движения вперёд. Чем дольше вы едете вперёд, тем больший прирост "
"скорости получаете, что позволяет с лёгкостью перемещаться по полю боя."

msgid "characteristics/abilities/special/description/propellantAfterburnerGun"
msgstr ""
"Система постепенно накапливает заряд, который частично тратится для "
"увеличения урона во время выстрела. Чем больше заряд, тем выше "
"дополнительный урон. По умолчанию система набирает заряд до определённого "
"значения. Отключение ограничителя позволяет накопить больше заряда, чтобы "
"нанести больше дополнительного урона, но это ухудшает стабилизацию орудия."

msgid "characteristics/abilities/special/description/rechargeableNitro"
msgstr ""
"Жидкотопливные ускорители дают бонус к мощности двигателя, что позволяет вам"
" занимать более выгодные позиции на поле боя. Однако они ограничивают "
"скорость движения задним ходом и скорость поворота корпуса. Ускорители можно"
" включить и отключить в любой момент, пока не будет достигнут лимит "
"повторной активации. Они нагреваются при использовании и становятся "
"недоступны до остывания. Это значит, что их нельзя использовать непрерывно. "
"При критическом уровне нагрева ускорители временно отключаются — планируйте "
"свои действия, чтобы не оказаться застигнутым врасплох."

msgid "characteristics/abilities/special/description/shellCalibration"
msgstr ""
"При попадании по обнаруженному противнику взрыватель следующего снаряда "
"подстраивается под результат. Если удалось пробить броню, урон следующего "
"боеприпаса увеличивается. В противном случае повышается его бронепробитие."

msgid "characteristics/abilities/special/description/shellParamsSwitcher"
msgstr ""
"Орудие оснащено устройствами, которые позволяют изменять некоторые параметры"
" снаряда перед выстрелом. В снаряжении указано, какие характеристики "
"боеприпаса изменятся при переключением режима огня."

msgid "characteristics/abilities/special/description/sightPointer"
msgstr ""
"Улучшенное оптическое устройство, которое увеличивает дальность обзора и "
"упрощает обнаружение движущихся и замаскированных целей. При активации "
"устройство сканирует сектор перед вашей машиной, обнаруживая скрытые цели. "
"Если оно раскрывает необнаруженного противника, ваша машина также немедленно"
" становится обнаруженной. Вы можете вручную остановить сканирование после "
"небольшой задержки."

msgid "characteristics/abilities/special/description/stagedJetBoosters"
msgstr ""
"Твердотопливные ускорители улучшают разгон, мобильность и манёвренность на "
"несколько секунд. Левый и правый ускорители могут работать независимо друг "
"от друга, чтобы обеспечить более быстрый поворот корпуса. Их использование "
"не влияет на скорость заднего хода. Ускорители можно использовать несколько "
"раз за бой, но перед повторной активацией требуется перезарядка."

msgid "characteristics/abilities/special/description/stanceDance"
msgstr ""
"В зависимости от активного режима и уровня заряда машина может активировать одну из двух способностей: ионно-разрядный дожигатель или параллаксный электромеханический прицел.\n"
"Ионно-разрядный дожигатель временно увеличивает мощность двигателя и максимальную скорость движения вперёд и назад. Параллаксный электромеханический прицел временно снижает разброс и ускоряет перезарядку."

msgid "characteristics/abilities/special/description/stationaryReload"
msgstr ""
"Модуль внешней подачи боеприпасов позволяет вам прервать перезарядку и "
"начать стрелять в любое время, если у вас остался заряженным хотя бы один "
"снаряд. Во время перезарядки модуль блокирует башню машины и внешние "
"контейнеры со снарядами, что не позволяет вам целиться и стрелять без "
"прерывания процесса в течение определённого периода."

msgid "characteristics/abilities/special/description/supportWeapon"
msgstr ""
"Машина оснащена набором вспомогательных орудий, которые обладают собственным"
" циклом перезарядки, что позволяет наносить дополнительный урон, когда это "
"необходимо."

msgid "characteristics/abilities/special/description/targetDesignator"
msgstr ""
"Лазерный целеуказатель добавляет специальный эффект к вашему следующему "
"выстрелу, который применяется к машине противника, в которую вы попадёте. "
"Эффект зависит от статуса обнаружения. Попадание по обнаруженной машине "
"противника отметит её, из-за чего она будет получать больше урона от "
"снарядов и дольше оставаться видимой. Попадание по необнаруженной технике "
"подсветит её положение специальным маркером."

msgid "characteristics/abilities/special/description/twinGun"
msgstr ""
"Позволяет нанести двойной урон, а также улучшает стабилизацию за счёт "
"ухудшения показателей мобильности, разброса, скорости вращения башни и "
"времени сведения. Лучше всего использовать в ближнем бою."

msgid "characteristics/abilities/special/description/wheeledDash"
msgstr ""
"Механические улучшения значительно улучшают параметры ускорения, мощности "
"двигателя и максимальной скорости машины на короткое время, что позволяет "
"быстро реагировать на атаки противника и заставать соперников врасплох "
"динамическими манёврами. Движение на высокой скорости снижает время "
"подготовки механики."

msgid "characteristics/abilities/special/notes"
msgstr ""
"Все указанные значения являются максимально возможными для машины. "
"Оборудование, инструкции и снаряжение могут изменять их, но такие значения "
"здесь не отображаются."

