msgid "F88_AMX_13_105_grinch"
msgstr "Carrier"

msgid "F88_AMX_13_105_grinch_descr"
msgstr ""
"The Carrier is a stealthy high-speed assassin that focuses on stealing and "
"delivering presents. It excels at executing dangerous hit-and-run attacks in"
" enemy territory and disrupting enemies before disappearing into the "
"shadows."

msgid "_105mm_OFL_105_D1504_grinch"
msgstr "Paper Bullets"

msgid "_105mm_OFL_105_D1504_grinch_descr"
msgstr "Magazine gun with slow armor-penetrating paper bullets."
