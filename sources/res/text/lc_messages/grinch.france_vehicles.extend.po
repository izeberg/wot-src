msgid "F88_AMX_13_105_grinch"
msgstr "运载能手"

msgid "F88_AMX_13_105_grinch_descr"
msgstr "运载能手是一辆来去无踪的快速坦克，主要用于盗取和运送礼物。它擅长在敌人的领地上实施极具威胁的游击战术，随后潜形匿迹。"

msgid "_105mm_OFL_105_D1504_grinch"
msgstr "纸弹"

msgid "_105mm_OFL_105_D1504_grinch_descr"
msgstr "一门高射速的弹夹炮，使用飞行速度较慢的常规纸弹。"
