msgid "bannerTooltip/allStagesAreCompleted"
msgstr "All Data Blocks are completed!"

msgid "bannerTooltip/dataBlock"
msgstr "Data Block {{level}}"

msgid "bannerTooltip/description"
msgstr ""
"Take control of the antennas. Hold the network. Secure the transmission."

msgid "bannerTooltip/expiryDate/timerText"
msgstr "Mode will be available for"

msgid "bannerTooltip/header"
msgstr "Black Signal"

msgid "bannerTooltip/mode"
msgstr "MODE"

msgid "bannerTooltip/modeHint"
msgstr "— switching to another game mode"

msgid "bannerTooltip/performanceRisk/text/highRisk"
msgstr ""
"Your computer's performance is insufficient for this mode. You will "
"experience issues with graphics and vehicle movement. Game client crashes "
"are also probable."

msgid "bannerTooltip/performanceRisk/text/lowRisk"
msgstr ""
"In case of insufficient performance, try lowering the graphics settings."

msgid "bannerTooltip/performanceRisk/text/mediumRisk"
msgstr ""
"This mode demands high computer performance. You may experience issues with "
"map loading, graphics, and vehicle movement. In case of insufficient "
"performance, try a lower graphics quality in Settings."

msgid "bannerTooltip/performanceRisk/title/highRisk"
msgstr "Low Performance"

msgid "bannerTooltip/performanceRisk/title/lowRisk"
msgstr "The mode is demanding on the computer"

msgid "bannerTooltip/performanceRisk/title/mediumRisk"
msgstr "Reduced Performance"

msgid "battleEfficiency/baseHeal"
msgstr "Hit Points recovered"

msgid "battleEfficiency/personalPoints"
msgstr "Service Score"

msgid "battleLoading/description"
msgstr ""
"Take control of the antennas. Hold the network. Secure the transmission."

msgid "battleLoading/header"
msgstr "Black Signal"

msgid "battleLoading/tips/tip01/description"
msgstr ""
"Capturing an antenna restores a small amount of your vehicle's HP. Use this "
"bonus to hold the position and prepare for the counterattack."

msgid "battleLoading/tips/tip01/title"
msgstr "Secure and Recover"

msgid "battleLoading/tips/tip02/description"
msgstr ""
"Antennas cannot be captured while enemy vehicles are present. Deal with any "
"interlopers to continue securing an objective."

msgid "battleLoading/tips/tip02/title"
msgstr "Contested Capture"

msgid "battleLoading/tips/tip03/description"
msgstr ""
"After redeployment, your vehicle is protected from damage for 10 seconds. "
"Use this time to return to the fight or take cover."

msgid "battleLoading/tips/tip03/title"
msgstr "Redeployment Protection"

msgid "battleQueue/title"
msgstr "Black Signal"

