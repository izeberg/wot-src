msgstr "Steel Seals"

msgid "proxy_currency_tooltip/title/stpcoin"
msgstr "Lucky Seals"

msgid "quests/bonuses/progressionToken/body"
msgstr ""
"Awarded for completing special missions in Steel Hunter. They allow you to "
"advance through the Progression."

msgid "quests/bonuses/progressionToken/header"
msgstr "Steel Hunter Progression Points"

msgid "rewardCurrencyTooltip/body/battlePassPoints"
msgstr ""
"Points can be earned by fighting in battles and completing special missions."
" They are automatically added to the Battle Pass Progression."

msgid "rewardCurrencyTooltip/body/brProgressionToken"
msgstr ""
"Awarded for completing Steel Hunter missions and for good battle results. "
"They allow you to advance through the Progression."

msgid "rewardCurrencyTooltip/body/brcoin"
msgstr ""
"Steel Seals can be received for efficient battle performance, achieving high"
" positions in the battle results, and completing special missions."

msgid "rewardCurrencyTooltip/body/credits"
msgstr "The main in-game currency. Earned in battles or purchased with gold."

msgid "rewardCurrencyTooltip/body/crystal"
msgstr ""
"A rare, special currency used to purchase unique items that are unavailable "
"through other means."

msgid "rewardCurrencyTooltip/body/stpcoin"
msgstr ""
"Currency that can be earned in Steel Hunter battles. Seals can be exchanged "
"for unique rewards in the Shamrock Shop. When playing in a Platoon, Seals "
"are divided equally among Platoon members. The specified amount is your part"
" of the total earnings."

msgid "rewardCurrencyTooltip/body/xp"
msgstr ""
"The experience earned in special vehicles can be converted to Free "
"Experience."

msgid "rewardCurrencyTooltip/dailyBonus/stpcoin"
msgstr ""
"Bonus applied! The number of Seals received in battle is increased by "
"%(count)s times."

msgid "rewardCurrencyTooltip/header/battlePassPoints"
msgstr "Battle Pass Points"

msgid "rewardCurrencyTooltip/header/brProgressionToken"
msgstr "Steel Hunter Progression Points"

msgid "rewardCurrencyTooltip/header/brcoin"
msgstr "Steel Seals"

msgid "rewardCurrencyTooltip/header/credits"
msgstr "Credits"

msgid "rewardCurrencyTooltip/header/crystal"
msgstr "Bonds"

msgid "rewardCurrencyTooltip/header/stpcoin"
msgstr "Lucky Seals"

msgid "rewardCurrencyTooltip/header/xp"
msgstr "Combat Experience"

msgid "rewardCurrencyTooltip/premiumBonus/brcoin"
msgstr ""
"WoT Premium Account increases the amount of this currency earned by 50%."

msgid "rewardCurrencyTooltip/premiumBonus/credits"
msgstr ""
"WoT Premium Account increases the amount of this currency earned by 50%."

msgid "rewardCurrencyTooltip/premiumBonus/xp"
msgstr ""
"WoT Premium Account increases the amount of Combat Experience earned by 50%."

