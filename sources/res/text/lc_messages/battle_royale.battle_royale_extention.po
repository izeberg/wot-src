msgid "tooltip/progressionWidget/description/completed"
msgstr "Solid work, Commander. Keep it up!"

msgid "tooltip/progressionWidget/description/header"
msgstr "Main Progression Complete!"

msgid "tooltip/progressionWidget/description/inProgress"
msgstr ""
"To advance through the Progression, complete missions and reach the top "
"positions in Steel Hunter battles."

msgid "tooltip/progressionWidget/subTitle"
msgstr "The mode ends in %(value)s"

msgid "tooltip/progressionWidget/title"
msgstr "Steel Hunter"

msgid "tooltip/quest/header"
msgstr "Steel Hunter Mission"

msgid "tooltip/shop/stPatrick/subtitle"
msgstr ""
"Exchange your {ede6d9_Open}Lucky Seals{ede6d9_Close} for special rewards."

msgid "tooltip/shop/stPatrick/text"
msgstr ""
"Receive Lucky Seals for picking up Spoils of War in battle, completing "
"Progression Stages, and taking the top positions in the battle royale."

msgid "tooltip/shop/stPatrick/title"
msgstr "Shamrock Shop"

msgid "tooltip/shop/subtitle"
msgstr ""
"Exchange your {ede6d9_Open}Steel Seals{ede6d9_Close} for special rewards."

msgid "tooltip/shop/text"
msgstr ""
"Earn Steel Seals by performing effectively in battle, ranking highly in "
"post-battle results, and completing missions."

msgid "tooltip/shop/title"
msgstr "Steel Hunter Shop"

msgid "upgrades/description"
msgstr ""
"Cause damage to enemy vehicles and collect Spoils of War on the map to "
"receive experience and advance through tiers. Each tier reached allows you "
"to upgrade a module from the Upgrade Menu and significantly improve your "
"vehicle's characteristics."

msgid "upgrades/footer"
msgstr "Modules can only be upgraded in battle."

msgid "upgrades/subtitle"
msgstr "You enter battle in a Tier I vehicle."

msgid "upgrades/title"
msgstr "Vehicle Upgrades in Battle"
