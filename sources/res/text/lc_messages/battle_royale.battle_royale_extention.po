msgstr ""
"Complete missions to earn Progression Points.\n"
"The number of Points you earn also depends on your position in battle. %(infotip)s"

msgid "proxy_currency_tooltip/earn/description/brcoin"
msgstr ""
"Receive Steel Seals for efficient battle performance, achieving high "
"positions in the battle results, and completing the mode missions."

msgid "proxy_currency_tooltip/earn/description/stpcoin"
msgstr ""
"Receive Lucky Seals for picking up Spoils of War in battle, completing "
"Progression Stages, and taking the top positions in Steel Hunter."

msgid "proxy_currency_tooltip/earn/title/brcoin"
msgstr "How to Earn Seals"

msgid "proxy_currency_tooltip/earn/title/stpcoin"
msgstr "How to Earn Seals"

msgid "proxy_currency_tooltip/spend/description/brcoin"
msgstr "Use the earned Steel Seals to purchase Steel Hunter styles."

msgid "proxy_currency_tooltip/spend/description/stpcoin"
msgstr ""
"Exchange your earned Lucky Seals for valuable rewards in the Shamrock Shop."

msgid "proxy_currency_tooltip/spend/title/brcoin"
msgstr "What to Spend Seals On"

msgid "proxy_currency_tooltip/spend/title/stpcoin"
msgstr "What to Spend Seals On"

