msgid "tooltip/banner/description"
msgstr ""
"Dynamic last-man-standing battle royale in a post-apocalyptic setting. Fight"
" in eight special vehicles that can be upgraded as you battle, growing "
"stronger with each tier. Exclusive rewards and much more await you!"

msgid "tooltip/banner/mode/description"
msgstr "— Game mode. Click to explore"

msgid "tooltip/banner/mode/label"
msgstr "MODE"

msgid "tooltip/banner/performanceRisk/description/high"
msgstr ""
"Your computer's performance is insufficient for this mode. You may "
"experience issues with graphics and vehicle movement. Game client crashes "
"are also likely."

msgid "tooltip/banner/performanceRisk/description/medium"
msgstr ""
"This mode demands high computer performance. You may experience issues with "
"map loading, graphics, and vehicle movement. In case of insufficient "
"performance, try a lower graphics quality in Settings."

msgid "tooltip/banner/performanceRisk/title/high"
msgstr "Low Performance"

msgid "tooltip/banner/performanceRisk/title/medium"
msgstr "Possible Reduced Performance"

msgid "tooltip/banner/stPatrickDescription"
msgstr ""
"Dynamic last-man-standing battle royale with a touch of green magic. Fight "
"in eight special vehicles that can be upgraded as you battle, growing "
"stronger with each tier. Exclusive rewards and much more await you!"

msgid "tooltip/banner/stPatrickTitle"
msgstr "Shamrock Showdown"

msgid "tooltip/banner/timer/text/accent"
msgstr "Event available for %(timer)s"

msgid "tooltip/banner/timer/text/cooldown"
msgstr "Ceasefire %(timer)s"

msgid "tooltip/banner/title"
msgstr "Steel Hunter"

