msgstr "Desert"

msgid "leaveBattleView/description"
msgstr ""
"Your vehicles can still fight. If you leave the battle now, you will not "
"receive any rewards for it. Are you sure you want to leave the battle?"

msgid "leaveBattleView/title"
msgstr "Desertion From Battlefield"

msgid "leaveBattleView/warning"
msgstr "You will not receive rewards!"

