msgid "invites/note/change_and_leave/PREBATTLE_WHITE_TIGER"
msgstr ""
"You will be automatically removed from the current Harrier Platoon and be "
"transferred to the %(host)s server."

msgid "invites/note/change_and_leave/QUEUE_WHITE_TIGER"
msgstr ""
"Once you accept the invitation, you will exit Waffenträger and be "
"transferred to the %(host)s server."

msgid "invites/note/leave/PREBATTLE_WHITE_TIGER"
msgstr ""
"Once you accept the invitation, you will be automatically removed from the "
"current Harrier Platoon."

msgid "invites/note/leave/QUEUE_WHITE_TIGER"
msgstr "Once you accept the invitation, you will exit Waffenträger."

msgid "invites/prebattle/alreadyJoined/WHITE_TIGER"
msgstr "You have already joined the Platoon."

msgid "invites/text/WHITE_TIGER"
msgstr "Invitation to Platoon"
