msgstr "Четырёхцветный (обр. 1941 г.)"

msgid "camouflage/Sw_summer_02_generic_custom_look_3/description"
msgstr "Составная часть стиля «Шведская школа»."

msgid "camouflage/Sw_summer_02_generic_custom_look_3/label"
msgstr "Зимняя схема"

msgid "camouflage/Sw_winter_01/description"
msgstr ""
"Используется в зимнее время шведской армией с 1930-х гг. Камуфляж наносится "
"водорастворимой краской при помощи кистей или краскопульта."

msgid "camouflage/Sw_winter_01/label"
msgstr "Белый одноцветный"

msgid "camouflage/Sw_winter_02/description"
msgstr ""
"Используется в зимнее время шведской армией с 1930-х годов. Камуфляж "
"наносится водорастворимой краской при помощи кистей. Пятна разделяются "
"полосами незакрашенного базового цвета."

msgid "camouflage/Sw_winter_02/label"
msgstr "Пятнистый белый"

