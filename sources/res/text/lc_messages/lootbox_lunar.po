msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "剩余%(count)个灵蛇补给品"
msgstr[1] "剩余%(count)个灵蛇补给品"
msgstr[2] "剩余%(count)个灵蛇补给品"

msgid "awardViews/guaranteedTitle/text"
msgstr "保底奖励掉落前还需开启的最大灵蛇补给品数量: %(count)"

msgid "awardViews/quantityTitle/boxesAvailable"
msgstr "可用的灵蛇补给品: %(boxesCount)"

msgid "awardViews/quantityTitle/noBoxes"
msgstr "没有可用的灵蛇补给品"

msgid "boxTooltip/howGet/text/lunar"
msgstr "玩家可在军械库或特惠商城中购买灵蛇补给品礼包，开启其他类型的补给品时也有机会获得灵蛇补给品。"

msgid "common/boxCategory/lowerCase/lunar"
msgstr "灵蛇补给品"

msgid "common/boxCategory/upperCase/lunar"
msgstr "灵蛇补给品"

msgid "common/statistics/emptyHeader"
msgstr "开启灵蛇补给品即可查看统计数据。"

msgid "common/statistics/header"
msgstr "已开启的灵蛇补给品数量: %(count)"

msgid "common/statistics/tooltip/body"
msgstr "此处显示您在活动期间从灵蛇补给品中所获得的物品。您可随时手动重置统计数据。"

msgid "entryPoint/tooltip/description"
msgstr "这些特殊补给品内含全新且独特的物品，包括金币坦克、2D风格、《坦克世界》高级账号天数，以及其他好物。"

msgid "entryPoint/tooltip/title"
msgstr "灵蛇补给品及其获取方式"

msgid "entryPoint/tooltip/warningDescription"
msgstr "由于技术原因，目前无法开启或获取灵蛇补给品。我们对造成的不便深表歉意。"

msgid "entryPoint/tooltip/warningTitle"
msgstr "灵蛇补给品暂不可用"

msgid "eventName/lowerCase"
msgstr "2025春节"

msgid "eventName/upperCase"
msgstr "2025春节"

msgid "hasBoxesView/quantityTitle/boxesAvailable"
msgstr "可用的灵蛇补给品: %(boxesCount)"

msgid "hasBoxesView/quantityTitle/noBoxes"
msgstr "没有可用的灵蛇补给品"

msgid "infoPage/footer/description/autoOpen"
msgstr "如果您在活动结束前没有开启全部灵蛇补给品，那么系统会自动开启这些补给品。"

msgid "infoPage/footer/description/compensation"
msgstr "如果已拥有灵蛇补给品内容列表中的所有坦克，那么对于之后掉落的每辆坦克，您都将获得坦克当前价格对应的金币补偿。"

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"每%(guaranteed0)s个灵蛇补给品都保底内含1辆VIII–IX级坦克。如果这些补给品始终未掉落保底坦克，那么当您开启第%(guaranteed0)s个补给品时，必定会掉落1辆您尚未拥有的VIII–IX级坦克。补给品掉落坦克后，计数器将重置。"

msgid "infoPage/header/description"
msgstr "开启灵蛇补给品就有机会获得珍贵的游戏内物品！详情见下文。"

msgid "noBoxesView/description/"
msgstr ""
"您没有任何灵蛇补给品。\n"
"您可在军械库或特惠商城中购买灵蛇补给品礼包。"

msgid "noBoxesView/descriptionCn/"
msgstr ""
"您没有任何灵蛇补给品。\n"
"在特惠商城中购买特定物品即可获赠灵蛇补给品。"

msgid "serviceChannelMessages/finish/text"
msgstr "系统将开启所有剩余的灵蛇补给品。补给品内的物品将添加至您的账号。"

msgid "serviceChannelMessages/lootBoxDefault"
msgstr "灵蛇补给品"

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "已开启的灵蛇补给品数量: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "已开启剩余的补给品"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr "活动结束后，我们开启了您全部的灵蛇补给品，所含物品已添加至您的账号。"

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr "由于服务器维护，灵蛇补给品相关操作暂时无法进行。"

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "灵蛇补给品相关操作已恢复正常。去开启补给品吧！"

msgid "serviceChannelMessages/multipleOpen"
msgstr "已开启灵蛇补给品！"

msgid "serviceChannelMessages/start/text"
msgstr "仅持续至%(date)s: 金币坦克和珍贵游戏内物品等待着您！"

msgid "singleRewardView/tooltip/description/"
msgstr "如果已拥有灵蛇补给品内容列表中的所有坦克，那么对于之后掉落的每辆坦克，您都将获得坦克当前价格对应的金币补偿。"

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"保底奖励是补给品内容列表中的坦克。\n"
"如果开启%(remainingCount)个灵蛇补给品后仍未掉落保底坦克，那么当第%(count)个补给品开启时必定会掉落。补给品掉落坦克后，计数器将重置。"

msgid "statisticsRewards/label/lootBox_lunar"
msgstr "灵蛇补给品"
