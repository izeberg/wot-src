msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "%(count) remaining Serpentine Box"
msgstr[1] "%(count) remaining Serpentine Boxes"
msgstr[2] "%(count) remaining Serpentine Boxes"

msgid "awardViews/guaranteedTitle/text"
msgstr "Maximum Serpentine Boxes before a Guaranteed Reward: %(count)"

msgid "awardViews/quantityTitle/boxesAvailable"
msgstr "Serpentine Boxes available: %(boxesCount)"

msgid "awardViews/quantityTitle/noBoxes"
msgstr "No Serpentine Boxes available"

msgid "boxTooltip/howGet/text/lunar"
msgstr ""
"Serpentine Boxes can be purchased in the in-game Store or Premium Shop, as "
"well as received when opening boxes of any other kind."

msgid "common/boxCategory/lowerCase/lunar"
msgstr "Serpentine Box"

msgid "common/boxCategory/upperCase/lunar"
msgstr "SERPENTINE BOX"

msgid "common/statistics/emptyHeader"
msgstr "Open Serpentine Boxes to view statistics."

msgid "common/statistics/header"
msgstr "Serpentine Boxes opened: %(count)"

msgid "common/statistics/tooltip/body"
msgstr ""
"Here you can view the items you received from Serpentine Boxes during the "
"event. You can manually reset these statistics at any time."

msgid "entryPoint/tooltip/description"
msgstr ""
"These are special boxes containing new and unique items, including Premium "
"vehicles, 2D styles, days of WoT Premium Account, and more."

msgid "entryPoint/tooltip/title"
msgstr "Serpentine Boxes and How to Receive Them"

msgid "entryPoint/tooltip/warningDescription"
msgstr ""
"Serpentine Boxes cannot currently be opened or purchased due to technical "
"reasons. We apologize for the temporary inconvenience."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Serpentine Boxes Temporarily Unavailable"

msgid "eventName/lowerCase"
msgstr "Lunar New Year: Serpent's Treasure"

msgid "eventName/upperCase"
msgstr "LUNAR NEW YEAR: SERPENT'S TREASURE"

msgid "hasBoxesView/quantityTitle/boxesAvailable"
msgstr "Serpentine Boxes available: %(boxesCount)"

msgid "hasBoxesView/quantityTitle/noBoxes"
msgstr "No Serpentine Boxes available"

msgid "infoPage/footer/description/autoOpen"
msgstr ""
"If you do not open Serpentine Boxes before the end of the event, they will "
"be opened automatically."

msgid "infoPage/footer/description/compensation"
msgstr ""
"If you already own all vehicles from the list of possible box contents, then"
" all subsequent vehicles you receive from Serpentine Boxes will be "
"compensated in gold."

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"Every %(guaranteed0)s Serpentine Boxes are guaranteed to contain a Tier "
"VIII–IX vehicle. If you open them without one dropping such a vehicle, then "
"a Tier VIII–IX vehicle you do not already own will drop when you open the "
"%(guaranteed0)sth box. When it does, the counter is reset."

msgid "infoPage/header/description"
msgstr ""
"Open Serpentine Boxes for the chance to receive valuable in-game items! See "
"more details below."

msgid "noBoxesView/description/"
msgstr ""
"You do not have any Serpentine Boxes.\n"
"You can purchase them in the in-game Store or the Premium Shop."

msgid "noBoxesView/descriptionCn/"
msgstr ""
"You do not have any Serpentine Boxes.\n"
"You can receive them as a gift for purchasing items in the Premium Shop."

msgid "serviceChannelMessages/finish/text"
msgstr ""
"All remaining Serpentine Boxes will be opened. Their contents will be added "
"to your account."

msgid "serviceChannelMessages/lootBoxDefault"
msgstr "Serpentine Box"

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "Serpentine Boxes opened: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "Remaining Boxes Opened"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr ""
"At the end of the event, we opened all of your Serpentine Boxes and added "
"their contents to your account."

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr ""
"Operations with Serpentine Boxes are temporarily unavailable due to "
"maintenance."

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "Operations with Serpentine Boxes are available again. Open them!"

msgid "serviceChannelMessages/multipleOpen"
msgstr "Serpentine Boxes opened!"

msgid "serviceChannelMessages/start/text"
msgstr "Only until %(date)s: Premium vehicles and valuable in-game items!"

msgid "singleRewardView/tooltip/description/"
msgstr ""
"If you already own all vehicles from the list of possible box contents, then"
" all subsequent vehicles you receive from Serpentine Boxes will be "
"compensated in gold."

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"The Guaranteed Reward is a vehicle from the list of possible box contents.\n"
"If you open %(remainingCount) Serpentine Boxes without one dropping such a vehicle, it will drop when you open the %(count) box. When it does, the counter is reset."

msgid "statisticsRewards/label/lootBox_lunar"
msgstr "Serpentine Box"
