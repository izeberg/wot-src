msgid "Ch48_BZ_75_grinch"
msgstr "突击勇士"

msgid "Ch48_BZ_75_grinch_descr"
msgstr ""
"突击勇士非常适合用来冲锋陷阵，它能冲向中心，造成高额损伤，几乎不用担心自身安危。它擅长使整群敌人丧失作战能力，然后借助高能狂暴和冲撞将其逐一击破。"

msgid "_152mm_AP_T_grinch"
msgstr "纸球"

msgid "_152mm_AP_T_grinch_descr"
msgstr "一门常规火炮，射击飞行速度低、平均损伤高的高爆纸球。"
