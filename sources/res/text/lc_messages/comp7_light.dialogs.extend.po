msgid "comp7_light/deserter/cancel"
msgstr "Cancel"

msgid "comp7_light/deserter/message"
msgstr ""
"Your team needs you! Leaving a battle before it ends or before your vehicle is destroyed is considered desertion.\n"
"This may {brown_open}result in a disciplinary penalty.{brown_close}"

msgid "comp7_light/deserter/submit"
msgstr "Desert"

msgid "comp7_light/deserter/title"
msgstr "Desert the battlefield?"

msgid "punishmentWindow/reason/comp7_light_deserter"
msgstr ""
"Inaction in battle or leaving the battle before it ended/before the vehicle "
"was destroyed."
