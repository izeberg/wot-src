msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "%(count) remaining P-Modul"
msgstr[1] "%(count) remaining P-Modules"
msgstr[2] "%(count) remaining P-Modules"

msgid "awardViews/footer/backButton/"
msgstr "Back to P-Modules"

msgid "boxTooltip/description/text/wt_common"
msgstr ""
"When opened, P-Modul Protos may grant you Premium vehicles, in-game "
"currencies, and other valuable rewards."

msgid "boxTooltip/description/text/wt_epic"
msgstr ""
"When opened, P-Modul Primes may grant you Premium vehicles, in-game "
"currencies, and other valuable rewards."

msgid "boxTooltip/description/text/wt_rare"
msgstr ""
"When opened, P-Modul Alphas may grant you Premium vehicles, in-game "
"currencies, and other valuable rewards."

msgid "boxTooltip/howGet/text/wt_common"
msgstr ""
"P-Modul Protos can be obtained in the in-game Store or Premium Shop, as well"
" as received when opening P-Modules of any other kind."

msgid "boxTooltip/howGet/text/wt_epic"
msgstr ""
"P-Modul Primes can be received when opening P-Modules of any other kind."

msgid "boxTooltip/howGet/text/wt_rare"
msgstr ""
"P-Modul Alphas can be received when opening P-Modules of any other kind."

msgid "common/boxCategory/lowerCase/wt_common"
msgstr "P-Modul Proto"

msgid "common/boxCategory/lowerCase/wt_epic"
msgstr "P-Modul Prime"

msgid "common/boxCategory/lowerCase/wt_rare"
msgstr "P-Modul Alpha"

msgid "common/boxCategory/upperCase/wt_common"
msgstr "P-MODUL PROTO"

msgid "common/boxCategory/upperCase/wt_epic"
msgstr "P-MODUL PRIME"

msgid "common/boxCategory/upperCase/wt_rare"
msgstr "P-MODUL ALPHA"

msgid "common/getButton/lowerCase"
msgstr "Get P-Modules"

msgid "common/getButton/upperCase"
msgstr "GET P-MODULES"

msgid "common/loader"
msgstr "P-Modul opening..."

msgid "common/statistics/emptyHeader"
msgstr "Open P-Modules to view statistics."

msgid "common/statistics/header"
msgstr "P-Modules opened: %(count)"

msgid "common/statistics/tooltip/body"
msgstr ""
"Here you can view the items you received from P-Modules during the event. "
"You can manually reset these statistics at any time."

msgid "confirmResetLootBoxStatistics/description"
msgstr "All information on opened P-Modules will be deleted."

msgid "entryPoint/boxes"
msgstr "TO P-MODULES"

msgid "entryPoint/tooltip/description"
msgstr ""
"These are special containers that hold new and unique items, including Premium vehicles, customization elements, in-game currencies, and other valuable rewards.\n"
"P-Modules can be obtained in the in-game Store or Premium Shop as well as received when opening containers of any other kind."

msgid "entryPoint/tooltip/title"
msgstr "P-Modules and How to Receive Them"

msgid "entryPoint/tooltip/warningDescription"
msgstr ""
"P-Modules cannot currently be opened or obtained due to technical reasons. "
"We apologize for the temporary inconvenience."

msgid "entryPoint/tooltip/warningTitle"
msgstr "P-Modules Temporarily Unavailable"

msgid "eventName/lowerCase"
msgstr "Break the Paradox"

msgid "eventName/upperCase"
msgstr "BREAK THE PARADOX"

msgid "guaranteedTitle/nextBox"
msgstr "Guaranteed Reward in the next P-Modul!"

msgid "guaranteedTitle/text"
msgstr "Maximum P-Modules before a Guaranteed Reward: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr ""
"If you do not open P-Modules before end of event, they will be opened "
"automatically."

msgid "infoPage/footer/description/compensation"
msgstr ""
"If you already own all the vehicles from one type of P-Modul, you will "
"receive a P-Modul Prime as a reward from that type of P-Modul instead of a "
"vehicle."

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"Every %(guaranteed0)s P-Modul Proto, %(guaranteed1)s P-Modul Alpha, and "
"%(guaranteed2)s P-Modul Prime are guaranteed to contain a Premium vehicle. "
"If you open them without one dropping such a vehicle, then a Premium vehicle"
" you do not already own will drop when you open the "
"%(guaranteed0)s&zwnbsp;th&zwnbsp;/%(guaranteed1)s&zwnbsp;th&zwnbsp;/%(guaranteed2)sth"
" P-Modul (depending on the P-Modul type). When it does, the counter is "
"reset."

msgid "infoPage/footer/title/compensation"
msgstr "If All Vehicles Are Received"

msgid "infoPage/header/description"
msgstr ""
"Open the P-Modul for the chance to receive valuable in-game items! See more "
"details below."

msgid "multipleRewardView/header/subTitle/"
msgstr "From the %(name) (%(boxesCount) P-Modules opened)"

msgid "noBoxesView/description/"
msgstr ""
"You do not have any P-Modules. You can get them\n"
"in the in-game Store or the Premium Shop."

msgid "preview/backLabel"
msgstr "TO P-MODULES"

msgid "quantityTitle/boxesAvailable"
msgstr "P-Modules available: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No P-Modules available"

msgid "serviceChannelMessages/finish/text"
msgstr ""
"All remaining P-Modules will be opened. Their contents will be added to your"
" account."

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "P-Modules opened: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "Remaining P-Modules Opened"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr ""
"At the end of the event, we opened all of your P-Modules and added their "
"contents to your account."

msgid "serviceChannelMessages/lootBoxesDisabled/header"
msgstr "P-Modul Opening Suspended"

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr ""
"Operations with P-Modules are temporarily unavailable due to maintenance."

msgid "serviceChannelMessages/lootBoxesEnabled/header"
msgstr "P-Modul Opening Available"

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "Operations with P-Modules are available again. Open them!"

msgid "serviceChannelMessages/multipleOpen"
msgstr "P-Modules opened!"

msgid "serviceChannelMessages/server_error"
msgstr "P-Modul Not Opened"

msgid "singleRewardView/tooltip/description/"
msgstr ""
"If you already own all the vehicles from one type of P-Modul, you will "
"receive a P-Modul Prime as a reward from that type of P-Modul instead of a "
"vehicle."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) P-Modul"
msgstr[1] "%(remainingCount) P-Modules"
msgstr[2] "%(remainingCount) P-Modules"

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"The Guaranteed Reward is a vehicle from the list of possible P-Modul contents.\n"
"If you open %(remainingCount) without one dropping such a vehicle, it will drop when you open the %(count) P-Modul. When it does, the counter is reset."
