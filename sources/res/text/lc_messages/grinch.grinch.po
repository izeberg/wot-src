msgid "abilityTooltip/blizzard/body"
msgstr ""
"Unleashes a snowstorm around your vehicle, damaging and freezing enemies for"
" %duration% s, disabling their movement and abilities."

msgid "abilityTooltip/blizzard/header"
msgstr "Frost"

msgid "abilityTooltip/dart/body"
msgstr ""
"Fires glue that disables all abilities for %duration% s and deals damage "
"over time. Can be used from stealth."

msgid "abilityTooltip/dart/header"
msgstr "Glue"

msgid "abilityTooltip/jump/body"
msgstr ""
"Makes your vehicle jump in the direction of the camera without losing speed."

msgid "abilityTooltip/jump/header"
msgstr "Jump"

msgid "abilityTooltip/missiles/body"
msgstr ""
"Fires a guided missile after locking on for %duration% s. Tracks the target "
"until impact or line of sight is lost."

msgid "abilityTooltip/missiles/header"
msgstr "Missile"

msgid "abilityTooltip/rage/body"
msgstr ""
"For %duration% s, your vehicle gains faster reload, turret traverse, and "
"engine power, but takes damage every second. It cannot be destroyed during "
"this time."

msgid "abilityTooltip/rage/header"
msgstr "Rage"

msgid "abilityTooltip/ram/body"
msgstr ""
"Activates a rocket boost for %duration% s, reducing ramming damage taken and"
" disrupting guided missile tracking."

msgid "abilityTooltip/ram/header"
msgstr "Boost"

msgid "abilityTooltip/repairKit/body"
msgstr "Repairs your vehicle's tracks and restores a small amount of HP."

msgid "abilityTooltip/repairKit/header"
msgstr "Patch Tape"

msgid "abilityTooltip/shellAssault/body"
msgstr "Standard gun with very slow, high-damage explosive paper balls."

msgid "abilityTooltip/shellAssault/header"
msgstr "Paper Ball"

msgid "abilityTooltip/shellCarrier/body"
msgstr "Magazine gun with slow armor-penetrating paper bullets."

msgid "abilityTooltip/shellCarrier/header"
msgstr "Paper Bullets"

msgid "abilityTooltip/shellSupport/body"
msgstr ""
"Rapid-fire machine gun loaded with paper spikes. Precise at first, but "
"quickly loses accuracy."

msgid "abilityTooltip/shellSupport/header"
msgstr "Paper Spikes"

msgid "abilityTooltip/sonar/body"
msgstr ""
"Scans an area in front of the vehicle, damaging and marking enemies for "
"%duration% s. Marked targets stay visible and take extra damage."

msgid "abilityTooltip/sonar/header"
msgstr "Scan"

msgid "abilityTooltip/stealth/body"
msgstr "Become unspottable for %duration% s. First shot deals bonus damage."

msgid "abilityTooltip/stealth/header"
msgstr "Stealth"

msgid "abilityTooltip/turret/body"
msgstr ""
"Deploys a turret that spots and attacks enemies. Only two turrets can be "
"active at once—when a third is placed, the oldest one is removed."

msgid "abilityTooltip/turret/header"
msgstr "Turret"

msgid "arena_start_errors/prb/kick/timeout"
msgstr ""
"Maximum time in queue for battle has expired. Select another server or try "
"again later."

