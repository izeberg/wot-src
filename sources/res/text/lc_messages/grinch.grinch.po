msgid "battle/helpView/hint1"
msgstr "Presents spawn in the center of the map, but can be found all over it"

msgid "battle/helpView/hint2"
msgstr "Grab presents and deliver them to your team's base"

msgid "battle/helpView/hint3"
msgstr "You can also steal presents from enemy teams' bases"

msgid "battle/helpView/hint4"
msgstr "Destroy enemy vehicles to make them drop presents"

msgid "battle/helpView/title"
msgstr "How to Play"

msgid "battle/loadingScreen/hint1/description"
msgstr ""
"Collect presents to win. You can find them scattered on the map or at enemy "
"bases, and pick them up after destroying enemy vehicles."

msgid "battle/loadingScreen/hint1/title"
msgstr "Get the presents!"

msgid "battle/loadingScreen/hint2/description"
msgstr ""
"Stay alert, as other teams will try to steal presents from you. Prevent them"
" from doing so—or steal their presents first!"

msgid "battle/loadingScreen/hint2/title"
msgstr "Winter Raid"

msgid "battle/loadingScreen/hint3/description"
msgstr ""
"Your team's base will restore your HP over time, unless you are under enemy "
"fire."

msgid "battle/loadingScreen/hint3/title"
msgstr "Home sweet home"

msgid "battle/loadingScreen/hint4/description"
msgstr ""
"Choose the right vehicle type to maximize your performance. Carriers are "
"super-sneaky, Supports can heal allies, and Assaults deal huge damage."

msgid "battle/loadingScreen/hint4/title"
msgstr "Type it out"

msgid "battle/settings/disabled"
msgstr "You cannot change these settings in this game mode"

msgid "common/teams/blue"
msgstr "Team Blue"

msgid "common/teams/magenta"
msgstr "Team Purple"

