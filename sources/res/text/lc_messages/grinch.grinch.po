msgid "battle/helpView/giftDefend/hint1"
msgstr "夺取礼物，并将其运送至团队基地"

msgid "battle/helpView/giftDefend/hint2"
msgstr "礼物会在地图的特定区域出现——确保您的团队及时抵达并收集礼物"

msgid "battle/helpView/giftDefend/hint3"
msgstr "您也可从敌方团队的基地盗取礼物"

msgid "battle/helpView/giftDefend/hint4"
msgstr "击毁敌方坦克后，对方的礼物就会掉落"

msgid "battle/helpView/lastGiftStanding/hint1"
msgstr "夺取礼物，并将其运送至团队基地"

msgid "battle/helpView/lastGiftStanding/hint2"
msgstr "礼物会在地图的特定区域出现——确保您的团队及时抵达并收集礼物"

msgid "battle/helpView/lastGiftStanding/hint3"
msgstr "您也可从敌方团队的基地盗取礼物"

msgid "battle/helpView/lastGiftStanding/hint4"
msgstr "击毁敌方坦克后，对方的礼物就会掉落"

msgid "battle/helpView/title"
msgstr "规则"

msgid "battle/loadingScreen/hint1/description"
msgstr "收集礼物，赢得胜利。您可在地图上或敌方基地找到散落的礼物，也可在击毁敌方坦克后拾取对方掉落的礼物。"

msgid "battle/loadingScreen/hint1/title"
msgstr "夺取礼物！"

msgid "battle/loadingScreen/hint2/description"
msgstr "保持警惕，因为其他团队会尝试从您这里盗取礼物。阻止他们，或者先下手为强，盗取他们的礼物！"

msgid "battle/loadingScreen/hint2/title"
msgstr "寒冬突袭"

msgid "battle/loadingScreen/hint3/description"
msgstr "团队基地会逐渐恢复您的生命值，除非您正在受到敌人的攻击。"

msgid "battle/loadingScreen/hint3/title"
msgstr "直捣黄龙"

msgid "battle/loadingScreen/hint4/description"
msgstr "选择合适的坦克类型，最大限度地提高您的表现。运载能手来去无踪，防御标兵可侦察并狩猎敌人，而突击勇士则能造成高额损伤。"

msgid "battle/loadingScreen/hint4/title"
msgstr "您青睐哪种类型？"

