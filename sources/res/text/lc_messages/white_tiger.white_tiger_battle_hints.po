msgid "battleHints/wtOvertime_boss"
msgstr "消灭所有发电机旁的敌人！"

msgid "battleHints/wtOvertime_header"
msgstr "加时"

msgid "battleHints/wtOvertime_hunters"
msgstr "使任意一台发电机过载！"

msgid "battleHints/wtTimeRemaining_boss"
msgstr ""
"胜利就在眼前！\n"
