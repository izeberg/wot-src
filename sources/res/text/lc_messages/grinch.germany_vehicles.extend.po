msgid "Leopard1_grinch"
msgstr "支援标兵"

msgid "Leopard1_grinch_descr"
msgstr ""
"支援标兵负责战术防御，并监控战场上的态势变化，通过布置防御工事保护己方领地。它能直接支援和修复位于中心和基地周围的盟友，并阻止运载能手的攻击。"

msgid "Leopard1_npc_grinch"
msgstr "护卫坦克"

msgid "Leopard1_npc_grinch_descr"
msgstr "护卫坦克"

msgid "Pillbox_grinch"
msgstr "炮塔"

msgid "Pillbox_grinch_descr"
msgstr "炮塔能自主发现并攻击敌人，在近战中效能最高，建议部署在战略要地，这样既能发挥作用，又不容易被击毁。"

msgid "_105mm_AP_DM13_grinch"
msgstr "纸钉"

msgid "_105mm_AP_DM13_grinch_descr"
msgstr "一门高射速的自动炮，使用飞行速度较快的HE纸钉，非常适合用来击停运载能手。"
