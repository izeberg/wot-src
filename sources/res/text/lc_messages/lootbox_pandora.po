msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "%(count) remaining Raumfalte"
msgstr[1] "%(count) remaining Raumfaltes"
msgstr[2] "%(count) remaining Raumfaltes"

msgid "awardViews/footer/backButton/"
msgstr "Back to Raumfaltes"

msgid "boxTooltip/description/text/alpha"
msgstr ""
"When opened, these Raumfalte devices may grant you Premium vehicles, "
"customization elements, in-game currencies, and other valuable rewards."

msgid "boxTooltip/description/text/prime"
msgstr ""
"When opened, these Raumfalte devices may grant you Premium vehicles, "
"customization elements, in-game currencies, and other valuable rewards."

msgid "boxTooltip/description/text/proto"
msgstr ""
"When opened, these Raumfalte devices may grant you Premium vehicles, "
"customization elements, in-game currencies, and other valuable rewards."

msgid "boxTooltip/howGet/text/alpha"
msgstr "Can be received while opening Raumfaltes of any other kind."

msgid "boxTooltip/howGet/text/prime"
msgstr "Can be received while opening Raumfaltes of any other kind."

msgid "boxTooltip/howGet/text/proto"
msgstr ""
"Raumfalte Protos can be obtained in the in-game Store or Premium Shop as "
"well as received when opening Raumfaltes of any other kind."

msgid "common/boxCategory/lowerCase/alpha"
msgstr "Raumfalte Alpha"

msgid "common/boxCategory/lowerCase/prime"
msgstr "Raumfalte Prime"

msgid "common/boxCategory/lowerCase/proto"
msgstr "Raumfalte Proto"

msgid "common/boxCategory/upperCase/alpha"
msgstr "RAUMFALTE ALPHA"

msgid "common/boxCategory/upperCase/prime"
msgstr "RAUMFALTE PRIME"

msgid "common/boxCategory/upperCase/proto"
msgstr "RAUMFALTE PROTO"

msgid "common/getButton/lowerCase"
msgstr "Get Raumfaltes"

msgid "common/getButton/upperCase"
msgstr "GET RAUMFALTES"

msgid "common/loader"
msgstr "Raumfalte opening..."

msgid "common/statistics/emptyHeader"
msgstr "Open Raumfaltes to view statistics."

msgid "common/statistics/header"
msgstr "Raumfaltes opened: %(count)"

msgid "common/statistics/tooltip/body"
msgstr ""
"Here you can view the items you received from Raumfaltes during the event. "
"You can manually reset these statistics at any time."

msgid "confirmResetLootBoxStatistics/description"
msgstr "All information on opened Raumfaltes will be deleted."

msgid "entryPoint/boxes"
msgstr "TO RAUMFALTES"

msgid "entryPoint/tooltip/description"
msgstr ""
"These are special devices containing new and unique items, including Premium vehicles, customization elements, in-game currencies, and other valuable rewards.\n"
"Raumfaltes can be obtained in the in-game Store or Premium Shop as well as received when opening boxes of any other kind."

msgid "entryPoint/tooltip/title"
msgstr "Raumfaltes and How to Receive Them"

msgid "entryPoint/tooltip/warningDescription"
msgstr ""
"Raumfaltes cannot currently be opened or purchased due to technical reasons."
" We apologize for the temporary inconvenience."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Raumfaltes Temporarily Unavailable"

msgid "eventName/lowerCase"
msgstr "Beyond Pandora"

msgid "eventName/upperCase"
msgstr "BEYOND PANDORA"

msgid "guaranteedTitle/nextBox"
msgstr "Guaranteed Reward in the next Raumfalte!"

msgid "guaranteedTitle/text"
msgstr "Maximum Raumfaltes before a Guaranteed Reward: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr ""
"If you do not open all Raumfaltes before the end of the event, they will be "
"opened automatically later."

msgid "infoPage/footer/description/compensation"
msgstr ""
"If you already own all the vehicles from the Raumfaltes, you will receive a "
"Raumfalte Prime as a reward instead of a vehicle."

msgid "infoPage/footer/description/guaranteed"
msgstr ""
"Every %(guaranteed0)s Raumfalte Protos, %(guaranteed1)s Raumfalte Alphas, "
"and %(guaranteed2)s Raumfalte Primes are guaranteed to contain a Premium "
"vehicle. If you open them without one dropping such a vehicle, then a "
"Premium vehicle you do not already own will drop when you open the "
"%(guaranteed0)sth/%(guaranteed1)sth/%(guaranteed2)sth Raumfalte (depending "
"on the Raumfalte type). When it does, the counter is reset. "

msgid "infoPage/footer/title/compensation"
msgstr "If All Vehicles Are Received"

msgid "infoPage/header/description"
msgstr ""
"Open Raumfaltes for the chance to receive valuable in-game items!\n"
"See below for a list of possible rewards."

msgid "multipleRewardView/header/subTitle/"
msgstr "From the %(name) (%(boxesCount) Raumfaltes opened)"

msgid "noBoxesView/description/"
msgstr ""
"You do not have any Raumfaltes. You can get them\n"
"in the in-game Store or the Premium Shop."

msgid "preview/backLabel"
msgstr "TO RAUMFALTES"

msgid "quantityTitle/boxesAvailable"
msgstr "Raumfaltes available: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No Raumfaltes available"

msgid "serviceChannelMessages/finish/text"
msgstr ""
"All remaining Raumfaltes will be opened. Their contents will be added to "
"your account."

msgid "serviceChannelMessages/lootBoxesAutoOpen/count"
msgstr "Raumfaltes opened: %(boxes)s"

msgid "serviceChannelMessages/lootBoxesAutoOpen/header"
msgstr "Remaining Raumfaltes Opened"

msgid "serviceChannelMessages/lootBoxesAutoOpen/text"
msgstr ""
"At the end of the event, we opened all of your Raumfaltes and added their "
"contents to your account."

msgid "serviceChannelMessages/lootBoxesDisabled/header"
msgstr "Raumfalte Opening Suspended"

msgid "serviceChannelMessages/lootBoxesDisabled/text"
msgstr ""
"Operations with Raumfaltes are temporarily unavailable due to maintenance."

msgid "serviceChannelMessages/lootBoxesEnabled/header"
msgstr "Raumfalte Opening Available"

msgid "serviceChannelMessages/lootBoxesEnabled/text"
msgstr "Operations with Raumfaltes are available again. Open them!"

msgid "serviceChannelMessages/multipleOpen"
msgstr "Raumfaltes Opened!"

msgid "serviceChannelMessages/server_error"
msgstr "Raumfalte Not Opened"

msgid "singleRewardView/tooltip/boxName/"
msgstr "Raumfalte Prime"

msgid "singleRewardView/tooltip/description/"
msgstr ""
"If you already own all the vehicles from the Raumfaltes, you will receive a "
"Raumfalte Prime as a Guaranteed Reward instead of a vehicle."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) Raumfalte"
msgstr[1] "%(remainingCount) Raumfaltes"
msgstr[2] "%(remainingCount) Raumfaltes"

msgid "singleRewardView/tooltip/subtitle/"
msgstr ""
"The Guaranteed Reward is a vehicle from the list of possible Raumfalte contents.\n"
"If you open %(remainingCount) without one dropping such a vehicle, it will drop when you open the %(count) Raumfalte. When it does, the counter is reset."

msgid "statisticsRewards/label/lootBox_alpha"
msgstr "Raumfalte Alpha"

msgid "statisticsRewards/label/lootBox_prime"
msgstr "Raumfalte Prime"

msgid "statisticsRewards/label/lootBox_proto"
msgstr "Raumfalte Proto"
