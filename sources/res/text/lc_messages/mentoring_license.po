msgstr "Подтверждение перевода"

msgid "assignmentDialog/warning/oneWay"
msgstr ""
"Этот член экипажа будет демобилизован\n"
"без возможности восстановления."

msgid "assignmentDialog/warning/xpLose"
msgstr "{xpLose} дополнительного опыта будет потеряно."

