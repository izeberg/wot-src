msgstr ""
"今天是{{@ style (color $color)}}军营{{/}}的{{@ style (color $color)}}家乡{{/}}{{@ "
"style (color $color)}}菜{{/}}{{@ style (color $color)}}日{{/}}，{{@ style "
"(color $color)}}士兵们{{/}}获准用现有{{@ style (color $color)}}食材{{@ style (color "
"$defaultColor)}}{{@ style (color $color)}}烹制{{/}}{{@ style (color "
"$color)}}家乡{{/}}{{@ style (color $color)}}美食{{/}}。{{/}}{{/}}您的{{@ style "
"(color $color)}}爱犬{{/}}{{@ style (color $color)}}整日{{/}}{{@ style (color "
"$color)}}穿梭{{/}}{{@ style (color $color)}}于{{/}}{{@ style (color "
"$color)}}各个{{/}}{{@ style (color $color)}}炊事点{{/}}，{{@ style (color "
"$color)}}协助{{/}}{{@ style (color $color)}}运送{{/}}{{@ style (color "
"$color)}}物资{{/}}——因{{@ style (color $color)}}热心{{/}}{{@ style (color "
"$color)}}帮忙{{/}}而收获了不少{{@ style (color $color)}}投喂{{/}}。"

msgid "text/event_29"
msgstr ""
"今天是个{{@ style (color $color)}}重要的{{/}}{{@ style (color $color)}}日子{{@ style "
"(color $defaultColor)}}。{{/}}{{/}}您的{{@ style (color $color)}}爱宠{{/}}在{{@ "
"style (color $color)}}医院{{/}}度过了一整天，通过展示您训练的{{@ style (color "
"$color)}}才艺来{{/}}{{@ style (color $color)}}鼓{{/}}{{@ style (color "
"$color)}}舞{{/}}{{@ style (color $color)}}伤员{{/}}士气，并确保{{@ style (color "
"$color)}}探访{{/}}每位{{@ style (color $color)}}士兵{{@ style (color "
"$defaultColor)}}。{{/}}{{/}}一时间，萌犬让{{@ style (color $color)}}病房{{/}}内充满了{{@ "
"style (color $color)}}欢声笑语{{/}}，气氛{{@ style (color $color)}}热闹非凡{{/}}。"

msgid "text/event_3"
msgstr ""
"您目睹{{@ style (color $color)}}爱犬{{/}}欢快地帮助{{@ style (color "
"$color)}}仓库{{/}}的{{@ style (color $color)}}小伙子们{{/}}运送{{@ style (color "
"$color)}}包裹{{/}}及其他{{@ style (color $color)}}物资{{@ style (color "
"$defaultColor)}}。{{/}}{{/}}日暮时分，感激的{{@ style (color $color)}}主管{{/}}送上小{{@ "
"style (color $color)}}礼包{{/}}作为对得力助手的酬谢。"

msgid "text/event_30"
msgstr ""
"今天，您的{{@ style (color $color)}}爱犬{{/}}帮助了常被忽视的{{@ style (color "
"$color)}}后勤{{/}}{{@ style (color $color)}}班组{{@ style (color "
"$defaultColor)}}。{{/}}{{/}}这只勤勉的{{@ style (color $color)}}猎犬{{/}}不仅运送{{@ "
"style (color $color)}}清洁{{/}}{{@ style (color $color)}}用具{{/}}，更尝试独自{{@ "
"style (color $color)}}拽{{/}}{{@ style (color $color)}}着{{/}}{{@ style (color"
" $color)}}拖把{{/}}{{@ style (color $color)}}拖地{{/}}。如此{{@ style (color "
"$color)}}笨拙{{/}}却{{@ style (color $color)}}不懈的{{/}}{{@ style (color "
"$color)}}付出{{/}}令大家{{@ style (color $color)}}一整天{{/}}都{{@ style (color "
"$color)}}士气{{/}}高昂。"

msgid "text/event_4"
msgstr ""
"{{@ style (color $color)}}萌犬{{/}}拖来装满杂乱{{@ style (color $color)}}工具{{@ style"
" (color $defaultColor)}}的{{@ style (color $color)}}木{{/}}{{@ style (color "
"$color)}}箱{{/}}。{{/}}{{/}}虽来源成谜，但其{{@ style (color "
"$color)}}打包{{/}}方式显然是有人特意为之。"

msgid "text/event_5"
msgstr ""
"{{@ style (color $color)}}萌犬{{/}}寻获一罐印有{{@ style (color $color)}}瑞典语{{/}}{{@"
" style (color $color)}}标签{{@ style (color $defaultColor)}}的{{@ style (color "
"$color)}}罐头{{/}}。{{/}}{{/}}它{{@ style (color $color)}}咬穿{{/}}{{@ style "
"(color $color)}}罐头{{/}}{{@ style (color $color)}}盖{{/}}后，竟顽皮地{{@ style "
"(color $color)}}追逐{{/}}{{@ style (color $color)}}四散奔逃{{/}}{{@ style (color "
"$color)}}的{{/}}{{@ style (color $color)}}士兵{{/}}——众人皆因罐头的{{@ style (color "
"$color)}}刺鼻{{/}}{{@ style (color $color)}}气味{{@ style (color "
"$defaultColor)}}而纷纷{{@ style (color "
"$color)}}避退{{/}}。{{/}}{{/}}一名从您身旁奔跑而过的{{@ style (color "
"$color)}}战友{{/}}向您奉上{{@ style (color $color)}}奖励{{/}}，以求终结这场{{@ style (color"
" $color)}}嗅觉风暴{{/}}。"

msgid "text/event_6"
msgstr ""
"一名{{@ style (color $color)}}炊事员{{/}}整日在{{@ style (color $color)}}车库{{@ style"
" (color $defaultColor)}}周边张贴{{@ style (color $color)}}寻{{/}}{{@ style (color"
" $color)}}猫{{/}}{{@ style (color $color)}}启事{{/}}。{{/}}{{/}}您的{{@ style "
"(color $color)}}爱犬{{/}}主动加入{{@ style (color $color)}}搜寻{{/}}行动，不出数小时，便在{{@ "
"style (color $color)}}兵营{{/}}附近找到了这只{{@ style (color $color)}}毛茸茸的{{/}}{{@ "
"style (color $color)}}\"逃犯\"{{/}}。"

msgid "text/event_7"
msgstr ""
"您的{{@ style (color $color)}}爱犬{{/}}发现了一台{{@ style (color $color)}}奇特{{/}}{{@"
" style (color $color)}}装置{{/}}，并整日叼着它在{{@ style (color "
"$color)}}车库{{/}}附近游荡。最终，一名{{@ style (color $color)}}机械师{{/}}辨认出这是{{@ style "
"(color $color)}}坦克{{/}}{{@ style (color $color)}}备用{{/}}{{@ style (color "
"$color)}}部件{{/}}，他小心地将其送至{{@ style (color $color)}}维修车间{{@ style (color "
"$defaultColor)}}。{{/}}{{/}}{{@ style (color $color)}}萌犬{{/}}对此次{{@ style "
"(color $color)}}发现{{@ style (color "
"$defaultColor)}}显得尤为自豪。{{/}}{{/}}无论该部件作何用途，您都将因这次{{@ style (color "
"$color)}}发现{{/}}赢得{{@ style (color $color)}}奖励{{/}}。"

msgid "text/event_8"
msgstr ""
"今夜正值{{@ style (color $color)}}月{{/}}{{@ style (color $color)}}圆{{@ style "
"(color $defaultColor)}}。{{/}}{{/}}沉醉于{{@ style (color $color)}}月光{{/}}的{{@ "
"style (color $color)}}萌犬{{/}}几乎彻夜长嚎，直至{{@ style (color $color)}}清晨{{@ style "
"(color $defaultColor)}}。{{/}}{{/}}被惊醒的{{@ style (color "
"$color)}}士兵们{{/}}尝试各种方法安抚这只{{@ style (color $color)}}小家伙{{/}}，却始终未见成效。"

msgid "text/event_9"
msgstr ""
"{{@ style (color $color)}}测试{{/}}期间，一辆{{@ style (color $color)}}坦克{{@ style "
"(color $defaultColor)}}突然{{@ style (color "
"$color)}}起火{{/}}。{{/}}{{/}}未待众人反应，您的{{@ style (color $color)}}爱犬{{/}}已冲入{{@ "
"style (color $color)}}燃烧中的{{/}}{{@ style (color $color)}}坦克{{/}}，协助{{@ style"
" (color $color)}}乘员{{/}}成功{{@ style (color $color)}}撤离{{@ style (color "
"$defaultColor)}}。{{/}}{{/}}这件{{@ style (color $color)}}英勇事迹{{/}}迅速传遍了整个{{@ "
"style (color $color)}}基地{{/}}。"

