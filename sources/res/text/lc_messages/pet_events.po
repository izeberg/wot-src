"$color)}}{{/}} давно {{@ style (color $color)}}расформированного{{/}} {{@ "
"style (color $color)}}{{/}}{{@ style (color $color)}}разведотряда{{/}}, {{@ "
"style (color $color)}}пропавшего{{/}} во время {{@ style (color "
"$color)}}зимних манёвров{{/}} {{@ style (color $color)}}много лет назад{{@ "
"style (color $defaultColor)}}. {{/}}{{/}}Никаких {{@ style (color "
"$color)}}записей{{/}} о нём не сохранилось."

msgid "text/event_26"
msgstr ""
