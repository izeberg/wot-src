"style (color $defaultColor)}}. {{/}}{{/}}Его {{@ style (color "
"$color)}}энтузиазм{{/}} быстро {{@ style (color $color)}}передался{{/}} {{@ "
"style (color $color)}}новобранцам{{/}}, которые начали {{@ style (color "
"$color)}}соревноваться{{/}} с {{@ style (color $color)}}псом{{/}} в {{@ "
"style (color $color)}}скорости{{/}} и {{@ style (color "
"$color)}}глубине{{/}}. {{@ style (color $color)}}Инструкторы{{/}} были {{@ "
"style (color $color)}}совсем не против{{/}}."

msgid "text/event_28"
msgstr ""
"{{@ style (color $color)}}Сегодня{{/}} в {{@ style (color "
"$color)}}лагере{{/}} был {{@ style (color $color)}}особенный{{/}} {{@ style "
"(color $color)}}день{{/}}: {{@ style (color $color)}}солдатам{{/}} разрешили"
