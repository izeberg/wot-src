msgid "_105mm_APCR_OFL_E1_WT"
msgstr "银弹"

msgid "_105mm_APCR_OFL_E1_WT_descr"
msgstr "同盟军械士的骄傲"

msgid "_105mm_APCR_OFL_E1_WT_long_special"
msgstr "每台过载的发电机都会为银弹充入等离子体。充能越多，等离子体造成的损伤就越高。在BT坦克的屏障失效时，向它射击以造成最大损伤。"

msgid "_105mm_APCR_OFL_E1_WT_short_special"
msgstr "利用等离子体造成额外损伤"

