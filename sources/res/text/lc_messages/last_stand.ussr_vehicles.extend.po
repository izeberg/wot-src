msgid "R171_IS_3_II_LS_BOT"
msgstr "冲锋者"

msgid "R171_IS_3_II_LS_BOT_descr"
msgstr "一辆重型坦克，配备双管火炮和可靠的装甲，拥有不俗的平均单发损伤。"

