msgid "abilityTooltip/description/builtinGrinchBlizzard"
msgstr ""
"Creates a close-range area-attack snowstorm within a "
"%(whiteSpanish_Open)s%(radius)s m radius%(whiteSpanish_Close)s around your "
"vehicle. The effect causes damage each second and freezes enemies for "
"%(whiteSpanish_Open)s%(debuffDuration)s s%(whiteSpanish_Close)s. Frozen "
"targets cannot move or use abilities."

msgid "abilityTooltip/description/builtinGrinchFlare"
msgstr ""
"Marks all targets within a %(whiteSpanish_Open)s%(radius)s m "
"radius%(whiteSpanish_Close)s for %(whiteSpanish_Open)s%(duration)s "
"s%(whiteSpanish_Close)s. Marked targets receive increased damage, remain "
"constantly spotted to all other teams, and are more frequently engaged by "
"bots."

msgid "abilityTooltip/description/builtinGrinchHeal"
msgstr ""
"Heals and inspires all allies within a %(whiteSpanish_Open)s%(radius)s m "
"radius%(whiteSpanish_Close)s around your vehicle for "
"%(whiteSpanish_Open)s%(duration)s s%(whiteSpanish_Close)s. Inspired allies "
"reload faster and have higher movement speed."

msgid "abilityTooltip/description/builtinGrinchRage"
msgstr ""
"For %(whiteSpanish_Open)s%(duration)s s%(whiteSpanish_Close)s, your vehicle "
"will have improved reload speed, turret traverse, and engine power, but it "
"will also receive damage each second. Your vehicle cannot be destroyed while"
" the ability is active."

msgid "abilityTooltip/description/builtinGrinchRepairkit"
msgstr "Repairs your vehicle's tracks and restores a small amount of HP."

msgid "abilityTooltip/description/builtinGrinchStealth"
msgstr ""
"You disappear for %(whiteSpanish_Open)s%(duration)s s%(whiteSpanish_Close)s "
"in a cloud of confetti and cannot be actively spotted. The effect is "
"canceled upon shooting, taking damage, or being marked by a flare. The first"
" shot out of stealth deals bonus damage."

msgid "abilityTooltip/description/builtinGrinchTurret"
msgstr ""
"Places a turret that spots and engages enemies independently. You can place "
"up to two turrets on the map. When you place a third, the oldest turret is "
"destroyed."

