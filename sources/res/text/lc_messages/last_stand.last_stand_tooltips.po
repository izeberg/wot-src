msgid "keys/body"
msgstr ""
"一种独特货币，可用于推进背水一战:潘多拉行动活动的进度，获取包括主要活动奖励在内的珍贵物品。该货币可通过参加活动战斗、作为完成每日任务的奖励获取，也可使用金币购买。对敌方坦克造成尽可能多的损伤，击毁尽可能多的敌方坦克，获取密钥。"

msgid "keys/bottom"
msgstr "活动结束时(%(date)s)，所有未使用的密钥都会被移除。"

msgid "keys/completeMissionDaily"
msgstr "• 完成每日任务(与激战难度一同解锁)"

msgid "keys/completeVehicleDaily"
msgstr "• 完成每日坦克任务"

msgid "keys/effective"
msgstr "• 战斗中的有效行为:"

msgid "keys/gold"
msgstr "• 花费金币购买"

msgid "keys/header"
msgstr "解密密钥"

