msgstr "Машина повреждена. Для выхода в бой необходимо выполнить ремонт."

msgid "tanks_carousel/vehicleStates/destroyed"
msgstr "Машина разбита. Для выхода в бой необходимо выполнить ремонт."

msgid "tanks_carousel/vehicleStates/disabled"
msgstr "Машина заблокирована"

msgid "tanks_carousel/vehicleStates/exploded"
msgstr "Машина взорвана. Для выхода в бой необходимо выполнить ремонт."

