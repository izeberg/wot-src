<?xml version="1.0" encoding="utf-8"?>
<root>
	<Properties/>
	<ClientMethods>
		<receiveShot>
			<Args>
				<hitPoint>VECTOR3</hitPoint>
				<hitDir>VECTOR3</hitDir>
				<normal>VECTOR3</normal>
				<shotID>INT64</shotID>
				<effectIndex>INT64</effectIndex>
				<matKind>INT64</matKind>
				<damagedDestructibles>
					ARRAY
					<of>UINT32</of>
				</damagedDestructibles>
			</Args>
		</receiveShot>
	</ClientMethods>
	<DefaultKeyName>shotsReceiver</DefaultKeyName>
</root>
