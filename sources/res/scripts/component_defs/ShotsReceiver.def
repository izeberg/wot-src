<?xml version="1.0" encoding="utf-8"?>
<root>
	<Implements>
		<Interface>ReplicableComponent</Interface>
	</Implements>
	<Properties/>
	<ClientMethods>
		<receiveShot>
			<Args>
				<hitPoint>VECTOR3</hitPoint>
				<hitDir>VECTOR3</hitDir>
				<speed>FLOAT32</speed>
				<normal>VECTOR3</normal>
				<shotID>INT64</shotID>
				<effectIndex>UINT8</effectIndex>
				<prefabEffectIndex>UINT8</prefabEffectIndex>
				<shellType>UINT8</shellType>
				<shellCaliber>FLOAT32</shellCaliber>
				<matKind>INT64</matKind>
				<damagedDestructibles>
					ARRAY
					<of>UINT32</of>
				</damagedDestructibles>
			</Args>
		</receiveShot>
	</ClientMethods>
	<DefaultKeyName>shotsReceiver</DefaultKeyName>
</root>
