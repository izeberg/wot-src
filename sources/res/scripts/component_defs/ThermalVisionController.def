<?xml version="1.0" encoding="utf-8"?>
<root>
	<DetailLevel>MY_VEHICLE</DetailLevel>
	<Properties>
		<stateStatus>
			<Type>THERMAL_VISION_STATE_STATUS</Type>
			<Flags>ALL_CLIENTS</Flags>
		</stateStatus>
	</Properties>
	<CellMethods>
		<tryActivate>
			<Exposed/>
		</tryActivate>
	</CellMethods>
	<ClientMethods>
		<onThermalObserved>
			<Arg>OBJECT_ID</Arg>
		</onThermalObserved>
		<onThermalDisappear>
			<Arg>OBJECT_ID</Arg>
		</onThermalDisappear>
		<onEnemyInSector/>
		<onSectorEmpty/>
		<updateUseCount>
			<Arg>INT32</Arg>
		</updateUseCount>
	</ClientMethods>
	<DefaultKeyName>thermalVisionController</DefaultKeyName>
</root>
