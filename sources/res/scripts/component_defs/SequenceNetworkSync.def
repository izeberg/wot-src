<?xml version="1.0" encoding="utf-8"?>
<root>
	<Implements>
		<Interface>ReplicableComponent</Interface>
	</Implements>
	<Properties>
		<syncTime>
			<Type>FLOAT</Type>
			<Flags>ALL_CLIENTS</Flags>
		</syncTime>
		<speed>
			<Type>FLOAT</Type>
			<Flags>ALL_CLIENTS</Flags>
		</speed>
		<state>
			<Type>UINT8</Type>
			<Flags>ALL_CLIENTS</Flags>
		</state>
		<activeLayerIdx>
			<Type>UINT8</Type>
			<Flags>ALL_CLIENTS</Flags>
		</activeLayerIdx>
		<transition>
			<Type>
				FIXED_DICT
				<Properties>
					<layerIdx>
						<Type>INT8</Type>
					</layerIdx>
					<time>
						<Type>FLOAT</Type>
					</time>
				</Properties>
				<AllowNone>true</AllowNone>
			</Type>
			<Flags>ALL_CLIENTS</Flags>
		</transition>
	</Properties>
	<CellMethods>
		<requestState>
			<Exposed/>
			<Args>
				<state>UINT8</state>
			</Args>
		</requestState>
		<requestTime>
			<Exposed/>
			<Args>
				<time>FLOAT</time>
			</Args>
		</requestTime>
		<requestLayerChange>
			<Exposed/>
			<Args>
				<layerIdx>UINT8</layerIdx>
				<time>FLOAT</time>
			</Args>
		</requestLayerChange>
	</CellMethods>
	<DefaultKeyName>sequenceNetworkSync</DefaultKeyName>
</root>
