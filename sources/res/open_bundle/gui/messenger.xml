<?xml version="1.0" encoding="utf-8"?>
<root>
	<htmlTemplatesSimple>
		<openBundleTankman>&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</openBundleTankman>
		<openBundleFixedReward>&lt;font color=&quot;#8C8C7E&quot;&gt;_(#open_bundle.open_bundle_lobby_default:serviceChannelMessages/fixedReward)&lt;/font&gt;&lt;br/&gt;%(text)s</openBundleFixedReward>
		<openBundleCellRewards>&lt;font color=&quot;#8C8C7E&quot;&gt;_(#open_bundle.open_bundle_lobby_default:serviceChannelMessages/cellRewards)&lt;/font&gt;&lt;br/&gt;%(text)s</openBundleCellRewards>
		<openBundlePriceInCredits>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#open_bundle.open_bundle:formatter/credits) &lt;font color=&apos;#D6D7D4&apos;&gt;%(amount)s&lt;/font&gt;&lt;/font&gt;</openBundlePriceInCredits>
		<openBundlePriceInGold>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#open_bundle.open_bundle:formatter/gold) &lt;font color=&apos;#FFC363&apos;&gt;%(amount)s&lt;/font&gt;&lt;/font&gt;</openBundlePriceInGold>
		<openBundlePriceInCrystal>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#open_bundle.open_bundle:formatter/crystal) &lt;font color=&apos;#C9C9B6&apos;&gt;%(amount)s&lt;/font&gt;&lt;/font&gt;</openBundlePriceInCrystal>
		<openBundlePriceInEventCoin>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#open_bundle.open_bundle:formatter/eventCoin) &lt;font color=&apos;#C9C9B6&apos;&gt;%(amount)s&lt;/font&gt;&lt;/font&gt;</openBundlePriceInEventCoin>
	</htmlTemplatesSimple>
	<htmlTemplates>
		<StartNotification>
			<groupID>info</groupID>
			<priority>high</priority>
			<gfViewName>StartNotification</gfViewName>
			<linkage>GamefaceNotification</linkage>
		</StartNotification>
		<SpecialRewardsNotification>
			<groupID>info</groupID>
			<priority>high</priority>
			<gfViewName>SpecialRewardsNotification</gfViewName>
			<linkage>GamefaceNotification</linkage>
		</SpecialRewardsNotification>
		<OpenBundleReminderSysMessage>
			<type>grey</type>
			<priority>medium</priority>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#open_bundle.open_bundle_lobby_default:serviceChannelMessages/reminder/button)</label>
					<action>openBundle</action>
				</button>
			</buttonsLayout>
		</OpenBundleReminderSysMessage>
		<OpenBundleFinishSysMessage>
			<type>grey</type>
			<priority>medium</priority>
			<icon>InformationIcon</icon>
			<message>&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
		</OpenBundleFinishSysMessage>
		<OpenBundleRewardsSysMessage>
			<type>grey</type>
			<priority>medium</priority>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;%(time)s&lt;br/&gt;%(text)s&lt;br/&gt;%(spentCurrency)s</message>
		</OpenBundleRewardsSysMessage>
	</htmlTemplates>
</root>
