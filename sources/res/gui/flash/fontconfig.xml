<?xml version="1.0" encoding="utf-8"?>
<root>
	<gameface>
		<fontfamily>
			<name>Warhelios</name>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/Warhelios-Regular.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/Warhelios-Bold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>WarheliosZHCN</name>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/WarheliosZHCN-Medium.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/WarheliosZHCN-Bold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>DINRoundPro</name>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/DINRoundPro-Bold.ttf</path>
			</font>
		</fontfamily>
		<deffontfamily>WarheliosZHCN</deffontfamily>
		<hieroglyphical>true</hieroglyphical>
		<fontfamilyfallback>Warhelios</fontfamilyfallback>
	</gameface>
	<config>
		<name>All</name>
		<fontlib>fonts_zh_cn_sg.swf</fontlib>
		<map>
			<alias>
				<embedded>$TitleFont</embedded>
				<runtime>TahomaZH</runtime>
			</alias>
			<alias>
				<embedded>$FieldFont</embedded>
				<runtime>TahomaZH</runtime>
			</alias>
			<alias>
				<embedded>$TextFont</embedded>
				<runtime>TahomaZH</runtime>
			</alias>
			<alias>
				<embedded>$UniversCondC</embedded>
				<runtime>TahomaZH</runtime>
				<scaleFactor>
					0.98
					<!--BW_String-->
				</scaleFactor>
			</alias>
		</map>
	</config>
</root>
