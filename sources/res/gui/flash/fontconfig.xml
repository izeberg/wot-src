<?xml version="1.0" encoding="utf-8"?>
<root>
	<gameface>
		<fontfamily>
			<name>Warhelios</name>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/Warhelios-Regular.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/Warhelios-Bold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>PFDINMax</name>
			<font>
				<style>normal</style>
				<weight>light</weight>
				<path>gui/gameface/fonts/pfdinmax/PFDINMax-CompressedBook.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/pfdinmax/PFDINMax-CompressedRegular.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>medium</weight>
				<path>gui/gameface/fonts/pfdinmax/PFDINMax-CompressedMedium.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>semi_bold</weight>
				<path>gui/gameface/fonts/pfdinmax/PFDINMax-CompressedSemiBold.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/pfdinmax/PFDINMax-CompressedBold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>DINRoundPro</name>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/DINRoundPro-Bold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>Jura</name>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/Jura-Regular.ttf</path>
			</font>
			<font>
				<style>normal</style>
				<weight>bold</weight>
				<path>gui/gameface/fonts/Jura-Bold.ttf</path>
			</font>
		</fontfamily>
		<fontfamily>
			<name>Pacifico</name>
			<font>
				<style>normal</style>
				<weight>normal</weight>
				<path>gui/gameface/fonts/Pacifico-Regular.ttf</path>
			</font>
		</fontfamily>
		<deffontfamily>Warhelios</deffontfamily>
	</gameface>
	<config>
		<name>All</name>
		<fontlib>fonts_sd.swf</fontlib>
		<map>
			<alias>
				<embedded>$TitleFont</embedded>
				<runtime>ZurichCondBold</runtime>
			</alias>
			<alias>
				<embedded>$FieldFont</embedded>
				<runtime>ZurichCond</runtime>
			</alias>
			<alias>
				<embedded>$TextFont</embedded>
				<runtime>Tahoma</runtime>
			</alias>
			<alias>
				<embedded>$UniversCondC</embedded>
				<runtime>UniversCondC</runtime>
			</alias>
		</map>
	</config>
</root>
