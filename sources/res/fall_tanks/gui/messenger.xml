<?xml version="1.0" encoding="utf-8"?>
<root>
	<htmlTemplates>
		<fallTanksBattleFinishedResult>
			<type>battleResult</type>
			<icon>BattleResultIcon</icon>
			<bgIcon>BgFallTanksBattleResultIcon</bgIcon>
			<bgIconHeight>100</bgIconHeight>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#messenger:serviceChannelMessages/battleResults/button)</label>
					<action>showBattleResults</action>
				</button>
			</buttonsLayout>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#fall_tanks.fall_tanks:serviceChannelMessages/battleResults/finished)&lt;/font&gt;
&lt;font color=&apos;#8C8C7E&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s&lt;/font&gt;
&lt;font color=&apos;#8C8C7E&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#fall_tanks.fall_tanks:serviceChannelMessages/battleResults/finishTime): %(finishTime)s&lt;/font&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(xp)s%(xpEx)s%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color=&apos;#8C8C7E&apos;&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s</message>
		</fallTanksBattleFinishedResult>
