			</Args>
			<Exposed/>
		</spawnLootAtShotPoint>
		<addSouls>
			<Args>
				<count>INT32</count>
			</Args>
			<Exposed/>
		</addSouls>
		<toggleBuff>
			<Args>
				<buffName>STRING</buffName>
			</Args>
			<Exposed/>
		</toggleBuff>
		<addModificator>
			<Args>
				<factorName>STRING</factorName>
				<op>STRING</op>
				<value>FLOAT32</value>
			</Args>
			<Exposed/>
		</addModificator>
		<removeFactor>
			<Args>
				<factorName>STRING</factorName>
			</Args>
			<Exposed/>
		</removeFactor>
		<spawnCampAtShotPoint>
			<Exposed/>
		</spawnCampAtShotPoint>
		<destroyCamp>
			<Exposed/>
		</destroyCamp>
		<killAllBots>
			<Args>
				<attackReason>STRING</attackReason>
			</Args>
			<Exposed/>
		</killAllBots>
		<killSelf>
			<Args>
				<attackReason>STRING</attackReason>
			</Args>
			<Exposed/>
		</killSelf>
		<spawnPersonalDeathZones>
			<Args>
				<onlyOwner>BOOL</onlyOwner>
				<deathzoneConfig>STRING</deathzoneConfig>
			</Args>
			<Exposed/>
		</spawnPersonalDeathZones>
	</CellMethods>
	<ClientMethods/>
	<Properties/>
	<ofEntity>
