<?xml version="1.0" encoding="utf-8"?>
<root>
	<htmlTemplatesSimple>
		<invoiceSimpleText>&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</invoiceSimpleText>
		<portalBattleResultProgressionPoints>%(progressionTokens)s</portalBattleResultProgressionPoints>
		<portalBattleResultVehicleUpgradePoints>%(vehicleUpgradePoints)s</portalBattleResultVehicleUpgradePoints>
	</htmlTemplatesSimple>
	<htmlTemplates>
		<PortalSystemMessage>
			<priority>medium</priority>
			<type>grey</type>
			<icon>InformationIcon</icon>
			<filters>
				<filter>
					<name>glow</name>
					<color>EA5200</color>
				</filter>
				<filter>
					<name>dropshadow</name>
					<color>
						000000
						<!--BW_String-->
					</color>
				</filter>
			</filters>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#portal.portal_messenger:serviceChannelMessages/example/button)</label>
					<action>portalAction</action>
				</button>
			</buttonsLayout>
			<message>&lt;font color=&apos;#8C8C7E&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/example/body)&lt;/font&gt;</message>
		</PortalSystemMessage>
		<portalBattleVictoryResult>
			<type>battleResult</type>
			<icon>BattleResultIcon</icon>
			<bgIcon>BgPortalResultIconVictory</bgIcon>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#messenger:serviceChannelMessages/battleResults/button)</label>
					<action>showBattleResults</action>
				</button>
			</buttonsLayout>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#messenger:serviceChannelMessages/battleResults/victory)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/eventName)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/difficulty/title): %(difficulty)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/progressionPoints): %(progressionTokens)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/vehicleUpgradePoints): %(vehicleUpgradePoints)s &lt;/font&gt;</message>
		</portalBattleVictoryResult>
		<portalBattleDrawGameResult>
			<type>battleResult</type>
			<icon>BattleResultIcon</icon>
			<bgIcon>BgPortalResultIconDraw</bgIcon>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#messenger:serviceChannelMessages/battleResults/button)</label>
					<action>showBattleResults</action>
				</button>
			</buttonsLayout>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#messenger:serviceChannelMessages/battleResults/drawGame)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/eventName)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/difficulty/title): %(difficulty)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/progressionPoints): %(progressionTokens)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/vehicleUpgradePoints): %(vehicleUpgradePoints)s &lt;/font&gt;</message>
		</portalBattleDrawGameResult>
		<portalBattleDefeatResult>
			<type>battleResult</type>
			<icon>BattleResultIcon</icon>
			<bgIcon>BgPortalResultIconDefeat</bgIcon>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#messenger:serviceChannelMessages/battleResults/button)</label>
					<action>showBattleResults</action>
				</button>
			</buttonsLayout>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#messenger:serviceChannelMessages/battleResults/defeat)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/eventName)&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/difficulty/title): %(difficulty)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/progressionPoints): %(progressionTokens)s &lt;/font&gt;
&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalBattleResults/vehicleUpgradePoints): %(vehicleUpgradePoints)s &lt;/font&gt;</message>
		</portalBattleDefeatResult>
		<PortalProgressionSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/progression/header)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#portal.portal_messenger:serviceChannelMessages/progression/stageAchieved/openBtnLabel)</label>
					<action>openPortalProgression</action>
					<width>107</width>
				</button>
			</buttonsLayout>
		</PortalProgressionSysMessage>
		<PortalMaxLevelCompletedSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/maxLevelCompleted/header)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#portal.portal_messenger:serviceChannelMessages/maxLevelCompleted/openBtnLabel)</label>
					<action>openPortalProgression</action>
					<width>107</width>
				</button>
			</buttonsLayout>
		</PortalMaxLevelCompletedSysMessage>
		<PortalAllVehiclesUpgradeSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/header)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/openBtnLabel)</label>
					<action>openPortalProgression</action>
					<width>107</width>
				</button>
			</buttonsLayout>
		</PortalAllVehiclesUpgradeSysMessage>
		<PortalVehicleUpgradeSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/header)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;
&lt;font color=&apos;#8C8C7E&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/levelUpgrade/spentPoints)&lt;/font&gt;&lt;font color=&apos;#E09687&apos;&gt;%(points)s&lt;/font&gt;</message>
		</PortalVehicleUpgradeSysMessage>
		<PortalResetVehicleUpgradeSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/reset/title)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#929290&apos;&gt;_(#portal.portal_messenger:serviceChannelMessages/vehicleUpgrade/reset/body)&lt;/font&gt;&lt;font color=&apos;#E09687&apos;&gt;%(points)s&lt;/font&gt;</message>
		</PortalResetVehicleUpgradeSysMessage>
		<PortalDifficultyLevelChangedSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font face=&quot;$TitleFont&quot; size=&quot;15&quot; color=&quot;#E9E2BF&quot;&gt;_(#portal.portal_messenger:serviceChannelMessages/portalDifficultyLevel/header)&lt;/font&gt;&lt;br/&gt;&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
		</PortalDifficultyLevelChangedSysMessage>
		<PortalEventEnabledSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
			<buttonsLayout>
				<button>
					<type>submit</type>
					<label>_(#portal.portal_messenger:serviceChannelMessages/eventState/enabled/openBtnLabel)</label>
					<action>openPortalProgression</action>
					<width>107</width>
				</button>
			</buttonsLayout>
		</PortalEventEnabledSysMessage>
		<PortalEventDisabledSysMessage>
			<icon>InformationIcon</icon>
			<message>&lt;font color=&apos;#8C8C7E&apos;&gt;%(text)s&lt;/font&gt;</message>
		</PortalEventDisabledSysMessage>
	</htmlTemplates>
</root>
